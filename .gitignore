!zenvis-plugin/zenvis-plugin-operation/
!zenvis-plugin/zenvis-plugin-risk/
!zenvis-plugin/zenvis-plugin-synap/
!zenvis-plugin/zenvis-plugin-user-event/

!zenvis-service/zenvis-service-vectum/
