# Copy this file to .env with `./zenvisctl compose init`.
# Never commit the generated .env file.

ARCH=amd64
TZ=Asia/Shanghai
ZENVIS_VERSION=1.0.0.alpha
ZENVIS_IMAGE_REGISTRY=crpi-4pdi7kz96g4v0tg3.cn-beijing.personal.cr.aliyuncs.com/coolxer-studio

ZENVIS_WEB_BIND_ADDRESS=0.0.0.0
ZENVIS_API_BIND_ADDRESS=127.0.0.1
ZENVIS_INFRA_BIND_ADDRESS=127.0.0.1
ZENVIS_WEB_PORT=11000
ZENVIS_API_PORT=11001
VECTUM_PORT=11002

MYSQL_DATABASE=zenvis
MYSQL_USER=zenvis
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
CLICKHOUSE_DATABASE=zenvis
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
KAFKA_CLUSTER_ID=

API_BEARER_TOKEN=
API_BEARER_USER=admin@admin.com
MCP_BEARER_TOKEN=
VECTUM_AUTH_TOKEN=
ZENVIS_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
ZENVIS_BOOTSTRAP_ADMIN_PASSWORD=

# AI is optional. Leave these values empty when AI capabilities are disabled.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
APP_AI_EMBEDDING_ENABLED=false
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_COMPLETION_URL=
OPENAI_COMPLETION_MODEL=
