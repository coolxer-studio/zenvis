{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "arch": { "type": "string", "enum": ["amd64", "arm64"] },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["arch", "version"]
    },
    "backend": {
      "type": "object",
      "properties": { "replicas": { "type": "integer", "minimum": 1, "maximum": 1 } }
    },
    "vectum": {
      "type": "object",
      "properties": { "replicas": { "type": "integer", "minimum": 1, "maximum": 1 } }
    },
    "secrets": {
      "type": "object",
      "properties": { "existingSecret": { "type": "string", "minLength": 1 } },
      "required": ["existingSecret"]
    },
    "external": {
      "type": "object",
      "properties": {
        "minio": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string", "minLength": 1 },
            "buckets": {
              "type": "object",
              "properties": {
                "rag": { "type": "string", "minLength": 1 },
                "chat": { "type": "string", "minLength": 1 },
                "plugins": { "type": "string", "minLength": 1 },
                "reports": { "type": "string", "minLength": 1 }
              },
              "required": ["rag", "chat", "plugins", "reports"]
            }
          },
          "required": ["endpoint", "buckets"]
        }
      },
      "required": ["minio"]
    }
  },
  "required": ["global", "secrets", "backend", "vectum", "external"]
}
