{
  "type": "page",
  "title": "Lubinsun任务",
  "toolbar": [
    {
      "type": "button",
      "label": "创建任务",
      "level": "primary",
      "actionType": "dialog",
      "dialog": {
        "title": "创建 Lubinsun Skill 任务",
        "size": "md",
        "body": {
          "type": "form",
          "api": "/zenvis/api/v1/lubinsun/tasks/add",
          "reload": "lubinsun_task_list",
          "body": [
            {
              "type": "hidden",
              "name": "name",
              "value": "SIP IP研判任务"
            },
            {
              "type": "hidden",
              "name": "skill",
              "value": "alert-auto-disposition"
            },
            {
              "type": "hidden",
              "name": "task_type",
              "value": "skill_run"
            },
            {
              "type": "hidden",
              "name": "agent",
              "value": "ops"
            },
            {
              "type": "input-text",
              "name": "ip",
              "label": "IP",
              "required": true,
              "clearable": true,
              "placeholder": "10.0.0.12,10.0.0.13",
              "description": "多个 IP 请用英文逗号分隔"
            },
            {
              "type": "textarea",
              "name": "raw_log",
              "label": "原始日志",
              "clearable": true,
              "minRows": 8,
              "maxRows": 16
            },
            {
              "type": "hidden",
              "name": "metadata_json",
              "value": "{\n  \"source_system\": \"management-platform\",\n  \"requested_by\": \"soc-operator\",\n  \"tenant_id\": \"tenant-demo\",\n  \"trace_id\": \"trace-20260628-0001\",\n  \"locale\": \"zh\"\n}"
            }
          ]
        }
      }
    },
    {
      "type": "button",
      "label": "刷新",
      "icon": "fa fa-refresh",
      "actionType": "reload",
      "target": "lubinsun_task_list"
    }
  ],
  "body": {
    "name": "lubinsun_task_list",
    "type": "crud",
    "api": "/zenvis/api/v1/lubinsun/tasks/list",
    "defaultParams": {
      "page": 1,
      "perPage": 10
    },
    "filter": {
      "title": "搜索",
      "body": [
        {
          "type": "group",
          "body": [
            {
              "type": "input-text",
              "name": "name",
              "label": "任务名称",
              "clearable": true
            },
            {
              "type": "input-text",
              "name": "skill",
              "label": "Skill",
              "clearable": true
            },
            {
              "type": "input-text",
              "name": "ip",
              "label": "IP",
              "clearable": true
            },
            {
              "type": "input-text",
              "name": "run_id",
              "label": "Run ID",
              "clearable": true
            },
            {
              "type": "select",
              "name": "status",
              "label": "状态",
              "clearable": true,
              "options": [
                {"label": "草稿", "value": "DRAFT"},
                {"label": "已接收", "value": "ACCEPTED"},
                {"label": "执行中", "value": "RUNNING"},
                {"label": "等待审批", "value": "WAITING_PERMISSION"},
                {"label": "已完成", "value": "COMPLETED"},
                {"label": "执行失败", "value": "FAILED"},
                {"label": "已中断", "value": "INTERRUPTED"},
                {"label": "调用失败", "value": "EXECUTE_FAILED"}
              ]
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "reset",
          "label": "重置"
        },
        {
          "type": "submit",
          "label": "查询",
          "level": "primary"
        }
      ]
    },
    "bulkActions": [
      {
        "type": "button",
        "label": "批量删除",
        "actionType": "ajax",
        "api": "delete:/zenvis/api/v1/lubinsun/tasks/bulk/${ids|raw}",
        "confirmText": "确定删除选中的 Lubinsun 任务？"
      }
    ],
    "columns": [
      {
        "name": "id",
        "label": "ID",
        "type": "text",
        "width": 70
      },
      {
        "name": "name",
        "label": "任务名称",
        "type": "text"
      },
      {
        "name": "skill",
        "label": "Skill",
        "type": "text"
      },
      {
        "name": "ip",
        "label": "IP",
        "type": "text",
        "placeholder": "-"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "mapping",
        "map": {
          "DRAFT": "<span class='label label-default'>草稿</span>",
          "ACCEPTED": "<span class='label label-info'>已接收</span>",
          "RUNNING": "<span class='label label-warning'>执行中</span>",
          "WAITING_PERMISSION": "<span class='label label-danger'>等待审批</span>",
          "COMPLETED": "<span class='label label-success'>已完成</span>",
          "FAILED": "<span class='label label-danger'>执行失败</span>",
          "INTERRUPTED": "<span class='label label-default'>已中断</span>",
          "EXECUTE_FAILED": "<span class='label label-danger'>调用失败</span>"
        }
      },
      {
        "name": "run_id",
        "label": "Run ID",
        "type": "text",
        "placeholder": "-"
      },
      {
        "name": "last_seq",
        "label": "Last Seq",
        "type": "text",
        "width": 90
      },
      {
        "name": "result_summary",
        "label": "摘要",
        "type": "text",
        "placeholder": "-"
      },
      {
        "type": "operation",
        "label": "操作",
        "width": 300,
        "buttons": [
          {
            "type": "button",
            "label": "执行",
            "level": "primary",
            "icon": "fa fa-play",
            "actionType": "ajax",
            "api": "post:/zenvis/api/v1/lubinsun/tasks/${id}/execute",
            "confirmText": "确认执行该任务并调用 Lubinsun /platform/runs？",
            "reload": "lubinsun_task_list",
            "disabledOn": "status == 'ACCEPTED' || status == 'RUNNING' || status == 'WAITING_PERMISSION'"
          },
          {
            "type": "button",
            "label": "刷新",
            "icon": "fa fa-refresh",
            "actionType": "ajax",
            "api": "post:/zenvis/api/v1/lubinsun/tasks/${id}/refresh",
            "reload": "lubinsun_task_list",
            "disabledOn": "!run_id || status == 'COMPLETED' || status == 'FAILED' || status == 'INTERRUPTED' || status == 'EXECUTE_FAILED'"
          },
          {
            "type": "button",
            "label": "详情",
            "icon": "fa fa-eye",
            "actionType": "drawer",
            "drawer": {
              "title": "Lubinsun 任务详情",
              "size": "lg",
              "body": {
                "type": "service",
                "api": "/zenvis/api/v1/lubinsun/tasks/${id}/view",
                "body": [
                  {
                    "type": "property",
                    "title": "任务信息",
                    "column": 2,
                    "items": [
                      {"label": "任务名称", "content": "${task.name}"},
                      {"label": "Skill", "content": "${task.skill}"},
                      {"label": "IP", "content": "${task.ip|default:'-'}"},
                      {"label": "状态", "content": "${task.status_description}"},
                      {"label": "Run ID", "content": "${task.run_id|default:'-'}"},
                      {"label": "Session ID", "content": "${task.session_id|default:'-'}"},
                      {"label": "Task ID", "content": "${task.platform_task_id|default:'-'}"},
                      {"label": "Last Seq", "content": "${task.last_seq|default:0}"},
                      {"label": "错误", "content": "${task.error_message|default:'-'}"}
                    ]
                  },
                  {
                    "type": "tabs",
                    "tabs": [
                      {
                        "title": "Input",
                        "body": [
                          {
                            "type": "json",
                            "name": "task.input"
                          }
                        ]
                      },
                      {
                        "title": "SIP日志",
                        "body": [
                          {
                            "type": "json",
                            "name": "task.event_logs"
                          },
                          {
                            "type": "divider"
                          },
                          {
                            "type": "json",
                            "name": "task.alarm_logs"
                          }
                        ]
                      },
                      {
                        "title": "原始日志",
                        "body": [
                          {
                            "type": "tpl",
                            "tpl": "<pre style='white-space: pre-wrap; word-break: break-all;'>${task.raw_log|default:'-'}</pre>"
                          }
                        ]
                      },
                      {
                        "title": "结果",
                        "body": [
                          {
                            "type": "json",
                            "name": "task.result"
                          }
                        ]
                      },
                      {
                        "title": "待审批",
                        "body": [
                          {
                            "type": "json",
                            "name": "task.pending_permissions"
                          }
                        ]
                      },
                      {
                        "title": "快照",
                        "body": [
                          {
                            "type": "json",
                            "name": "task.snapshot"
                          }
                        ]
                      },
                      {
                        "title": "事件",
                        "body": {
                          "type": "table",
                          "source": "${events}",
                          "columns": [
                            {"name": "seq", "label": "Seq", "width": 80},
                            {"name": "type", "label": "类型"},
                            {"name": "event_created_at", "label": "时间", "type": "datetime"},
                            {"name": "data", "label": "Data", "type": "json"}
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "编辑",
            "icon": "fa fa-pencil",
            "actionType": "dialog",
            "disabledOn": "status == 'ACCEPTED' || status == 'RUNNING' || status == 'WAITING_PERMISSION'",
            "dialog": {
              "title": "编辑 Lubinsun 任务",
              "size": "lg",
              "body": {
                "type": "form",
                "initApi": "/zenvis/api/v1/lubinsun/tasks/${id}/view",
                "api": "post:/zenvis/api/v1/lubinsun/tasks/${id}/update",
                "reload": "lubinsun_task_list",
                "data": {
                  "name": "${task.name}",
                  "skill": "${task.skill}",
                  "agent": "${task.agent}",
                  "external_id": "${task.external_id}",
                  "title": "${task.title}",
                  "task_type": "${task.task_type}",
                  "ip": "${task.ip}",
                  "raw_log": "${task.raw_log}",
                  "metadata_json": "${task.metadata_json}"
                },
                "body": [
                  {"type": "hidden", "name": "name"},
                  {"type": "hidden", "name": "skill"},
                  {"type": "hidden", "name": "agent"},
                  {"type": "hidden", "name": "task_type"},
                  {"type": "hidden", "name": "external_id"},
                  {"type": "hidden", "name": "title"},
                  {"type": "hidden", "name": "metadata_json"},
                  {"type": "input-text", "name": "ip", "label": "IP", "required": true, "clearable": true, "placeholder": "10.0.0.12,10.0.0.13", "description": "多个 IP 请用英文逗号分隔"},
                  {"type": "textarea", "name": "raw_log", "label": "原始日志", "clearable": true, "minRows": 8, "maxRows": 16}
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "删除",
            "icon": "fa fa-trash",
            "actionType": "ajax",
            "api": "delete:/zenvis/api/v1/lubinsun/tasks/${id}",
            "confirmText": "确定删除该任务？",
            "reload": "lubinsun_task_list",
            "disabledOn": "status == 'ACCEPTED' || status == 'RUNNING' || status == 'WAITING_PERMISSION'"
          }
        ]
      }
    ]
  }
}
