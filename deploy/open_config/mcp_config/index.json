{
  "type": "page",
  "title": "MCP 服务管理",
  "remark": null,
  "toolbar": [
    {
      "type": "button",
      "actionType": "dialog",
      "label": "新增 MCP 服务",
      "primary": true,
      "icon": "fa fa-plus",
      "dialog": {
        "title": "新增 MCP 服务",
        "mode": "horizontal",
        "size": "lg",
        "body": {
          "type": "form",
          "api": "/zenvis/api/v1/dih/mcp/servers/add",
          "reload": "mcp_server_list",
          "body": [
            {
              "label": "服务标识",
              "name": "code",
              "type": "input-text",
              "required": true,
              "clearable": true,
              "placeholder": "例如 risk-system"
            },
            {
              "label": "服务名称",
              "name": "name",
              "type": "input-text",
              "required": true,
              "clearable": true
            },
            {
              "label": "基础地址",
              "name": "base_url",
              "type": "input-url",
              "required": true,
              "clearable": true,
              "placeholder": "http://127.0.0.1:11002"
            },
            {
              "label": "SSE Endpoint",
              "name": "sse_endpoint",
              "type": "input-text",
              "value": "/sse",
              "required": true
            },
            {
              "label": "启用",
              "name": "enabled",
              "type": "switch",
              "value": true
            },
            {
              "label": "请求超时(秒)",
              "name": "request_timeout_seconds",
              "type": "input-number",
              "value": 30,
              "min": 1
            },
            {
              "label": "连接超时(秒)",
              "name": "connect_timeout_seconds",
              "type": "input-number",
              "value": 10,
              "min": 1
            },
            {
              "label": "固定请求头",
              "name": "headers",
              "type": "editor",
              "language": "json",
              "size": "md",
              "placeholder": "{\"Authorization\":\"Bearer token\"}"
            },
            {
              "label": "描述",
              "name": "description",
              "type": "textarea",
              "minRows": 2,
              "maxRows": 4,
              "clearable": true
            }
          ]
        }
      }
    },
    {
      "type": "button",
      "label": "刷新全部连接",
      "level": "info",
      "icon": "fa fa-refresh",
      "actionType": "ajax",
      "confirmText": "确认刷新全部已启用 MCP 服务连接？",
      "api": "post:/zenvis/api/v1/dih/mcp/servers/refresh",
      "reload": "mcp_server_list"
    },
    {
      "type": "button",
      "label": "业务 Agent MCP 工具提示词",
      "icon": "fa fa-file-text-o",
      "actionType": "dialog",
      "dialog": {
        "title": "业务 Agent MCP 工具提示词",
        "size": "lg",
        "body": {
          "type": "service",
          "api": "/zenvis/api/v1/dih/mcp/agent/prompt",
          "body": {
            "type": "code",
            "language": "markdown",
            "value": "${value|default:'暂无已连接 MCP 工具'}"
          }
        }
      }
    },
    {
      "type": "button",
      "label": "刷新",
      "icon": "fa fa-repeat",
      "actionType": "reload",
      "target": "mcp_server_list"
    }
  ],
  "body": [
    {
      "name": "mcp_server_list",
      "type": "crud",
      "api": "/zenvis/api/v1/dih/mcp/servers/list",
      "defaultParams": {
        "page": 1,
        "perPage": 10
      },
      "filter": {
        "title": "搜索",
        "body": [
          {
            "label": "关键词",
            "type": "input-text",
            "name": "keyword",
            "clearable": true,
            "placeholder": "匹配标识、名称、描述和地址"
          },
          {
            "label": "启用状态",
            "type": "select",
            "name": "enabled",
            "clearable": true,
            "options": [
              {
                "label": "已启用",
                "value": true
              },
              {
                "label": "已停用",
                "value": false
              }
            ]
          },
          {
            "label": "连接状态",
            "type": "select",
            "name": "connected",
            "clearable": true,
            "options": [
              {
                "label": "已连接",
                "value": true
              },
              {
                "label": "未连接",
                "value": false
              }
            ]
          }
        ],
        "actions": [
          {
            "type": "reset",
            "label": "重置"
          },
          {
            "type": "submit",
            "level": "primary",
            "label": "查询"
          }
        ]
      },
      "columns": [
        {
          "name": "id",
          "label": "ID",
          "type": "text",
          "width": 70,
          "toggled": true
        },
        {
          "name": "code",
          "label": "服务标识",
          "type": "text",
          "searchable": true,
          "toggled": true
        },
        {
          "name": "name",
          "label": "服务名称",
          "type": "text",
          "searchable": true,
          "toggled": true
        },
        {
          "name": "enabled",
          "label": "启用",
          "type": "mapping",
          "map": {
            "true": "<span class='label label-success'>已启用</span>",
            "false": "<span class='label label-default'>已停用</span>",
            "*": "<span class='label label-default'>未知</span>"
          },
          "toggled": true
        },
        {
          "name": "connected",
          "label": "连接",
          "type": "mapping",
          "map": {
            "true": "<span class='label label-success'>已连接</span>",
            "false": "<span class='label label-danger'>未连接</span>",
            "*": "<span class='label label-default'>未知</span>"
          },
          "toggled": true
        },
        {
          "name": "tool_count",
          "label": "工具数",
          "type": "text",
          "width": 80,
          "placeholder": "0",
          "toggled": true
        },
        {
          "name": "base_url",
          "label": "基础地址",
          "type": "tpl",
          "tpl": "${base_url|truncate:42}",
          "popOver": {
            "trigger": "hover",
            "position": "left-top",
            "showIcon": false,
            "body": {
              "type": "tpl",
              "tpl": "${base_url}${sse_endpoint}"
            }
          },
          "toggled": true
        },
        {
          "name": "last_error",
          "label": "最近错误",
          "type": "tpl",
          "tpl": "${last_error|truncate:36|default:'-'}",
          "popOver": {
            "trigger": "hover",
            "position": "left-top",
            "showIcon": false,
            "body": {
              "type": "tpl",
              "tpl": "${last_error|default:'无'}"
            }
          },
          "toggled": true
        },
        {
          "name": "last_connected_time",
          "label": "最近连接",
          "type": "text",
          "placeholder": "-",
          "toggled": true
        },
        {
          "type": "operation",
          "label": "操作",
          "width": 260,
          "buttons": [
            {
              "type": "button",
              "label": "工具",
              "icon": "fa fa-wrench text-info",
              "actionType": "dialog",
              "dialog": {
                "title": "MCP 工具 - ${name}",
                "size": "xl",
                "body": {
                  "type": "crud",
                  "api": "/zenvis/api/v1/dih/mcp/tools?serverId=${id}",
                  "syncLocation": false,
                  "columns": [
                    {
                      "name": "ai_tool_name",
                      "label": "AI工具名",
                      "type": "text"
                    },
                    {
                      "name": "name",
                      "label": "原始工具名",
                      "type": "text"
                    },
                    {
                      "name": "description",
                      "label": "描述",
                      "type": "tpl",
                      "tpl": "${description|truncate:80|default:'-'}"
                    },
                    {
                      "name": "read_only_hint",
                      "label": "只读",
                      "type": "mapping",
                      "map": {
                        "true": "<span class='label label-success'>是</span>",
                        "false": "<span class='label label-warning'>否</span>",
                        "*": "-"
                      }
                    },
                    {
                      "type": "operation",
                      "label": "操作",
                      "width": 100,
                      "buttons": [
                        {
                          "type": "button",
                          "label": "测试",
                          "icon": "fa fa-play text-success",
                          "actionType": "dialog",
                          "dialog": {
                            "title": "测试调用 ${name}",
                            "size": "lg",
                            "body": {
                              "type": "form",
                              "api": "post:/zenvis/api/v1/dih/mcp/tools/call",
                              "body": [
                                {
                                  "type": "hidden",
                                  "name": "server_id",
                                  "value": "${server_id}"
                                },
                                {
                                  "type": "hidden",
                                  "name": "name",
                                  "value": "${name}"
                                },
                                {
                                  "label": "参数",
                                  "name": "arguments",
                                  "type": "input-kv",
                                  "description": "按工具 inputSchema 填写参数键值"
                                },
                                {
                                  "label": "输入结构",
                                  "type": "code",
                                  "language": "json",
                                  "value": "${input_schema|json}"
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "刷新",
              "icon": "fa fa-refresh text-info",
              "actionType": "ajax",
              "api": "post:/zenvis/api/v1/dih/mcp/servers/${id}/refresh",
              "reload": "mcp_server_list"
            },
            {
              "type": "button",
              "label": "启用",
              "icon": "fa fa-play text-success",
              "hiddenOn": "data.enabled",
              "actionType": "ajax",
              "confirmText": "确认启用该 MCP 服务？",
              "api": "post:/zenvis/api/v1/dih/mcp/servers/${id}/enable",
              "reload": "mcp_server_list"
            },
            {
              "type": "button",
              "label": "停用",
              "icon": "fa fa-pause text-warning",
              "hiddenOn": "!data.enabled",
              "actionType": "ajax",
              "confirmText": "确认停用该 MCP 服务？",
              "api": "post:/zenvis/api/v1/dih/mcp/servers/${id}/disable",
              "reload": "mcp_server_list"
            },
            {
              "type": "button",
              "label": "编辑",
              "icon": "fa fa-pencil",
              "actionType": "dialog",
              "dialog": {
                "title": "编辑 MCP 服务",
                "mode": "horizontal",
                "size": "lg",
                "body": {
                  "type": "form",
                  "api": "/zenvis/api/v1/dih/mcp/servers/$id/update",
                  "reload": "mcp_server_list",
                  "body": [
                    {
                      "label": "服务标识",
                      "name": "code",
                      "type": "input-text",
                      "required": true,
                      "clearable": true
                    },
                    {
                      "label": "服务名称",
                      "name": "name",
                      "type": "input-text",
                      "required": true,
                      "clearable": true
                    },
                    {
                      "label": "基础地址",
                      "name": "base_url",
                      "type": "input-url",
                      "required": true,
                      "clearable": true
                    },
                    {
                      "label": "SSE Endpoint",
                      "name": "sse_endpoint",
                      "type": "input-text",
                      "required": true
                    },
                    {
                      "label": "启用",
                      "name": "enabled",
                      "type": "switch"
                    },
                    {
                      "label": "请求超时(秒)",
                      "name": "request_timeout_seconds",
                      "type": "input-number",
                      "min": 1
                    },
                    {
                      "label": "连接超时(秒)",
                      "name": "connect_timeout_seconds",
                      "type": "input-number",
                      "min": 1
                    },
                    {
                      "label": "固定请求头",
                      "name": "headers",
                      "type": "editor",
                      "language": "json",
                      "size": "md"
                    },
                    {
                      "label": "描述",
                      "name": "description",
                      "type": "textarea",
                      "minRows": 2,
                      "maxRows": 4,
                      "clearable": true
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "删除",
              "icon": "fa fa-times text-danger",
              "actionType": "ajax",
              "confirmText": "确认删除该 MCP 服务？",
              "api": "delete:/zenvis/api/v1/dih/mcp/servers/${id}",
              "reload": "mcp_server_list"
            }
          ],
          "toggled": true
        }
      ]
    }
  ]
}
