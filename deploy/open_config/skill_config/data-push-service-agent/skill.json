{
  "id": "data-push-service-agent",
  "name": "数据推送服务",
  "description": "系统内置数据推送服务智能体 Skill，基于已发布 Meta 创建、诊断和修复 PushTask。",
  "version": "2.0.0",
  "author": "ZenVis",
  "agentTypes": [
    "agent_data_push_service"
  ],
  "tags": [
    "builtin",
    "agent",
    "data-push",
    "vectum",
    "push-task"
  ],
  "chat": {
    "enabled": true,
    "label": "数据推送服务",
    "icon": "connection",
    "order": 11
  },
  "runtime": {
    "tools": {
      "local": {
        "config": [
          "config_tree",
          "config_read"
        ],
        "push-task": [
          "push_task_detect_format",
          "push_task_list_by_source_mark",
          "push_task_create_and_start",
          "push_task_get_log",
          "push_task_repair_and_restart",
          "push_task_delete_by_source_mark"
        ]
      }
    },
    "limits": {
      "maxToolCalls": 32,
      "maxRepeatedFailures": 2,
      "maxToolResultChars": 8000,
      "maxAccumulatedToolResultChars": 64000,
      "maxAccumulatedToolResultTokens": 48000
    }
  },
  "enabled": true,
  "entry": "SKILL.md"
}
