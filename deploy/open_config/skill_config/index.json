{
  "type": "page",
  "title": "AI Skill 管理",
  "remark": null,
  "toolbar": [
    {
      "type": "button",
      "label": "重载 Skill",
      "level": "info",
      "icon": "fa fa-refresh",
      "actionType": "ajax",
      "confirmText": "确认重新扫描 Skill 目录？",
      "api": "post:/zenvis/api/v1/dih/skills/reload",
      "reload": "skill_list"
    },
    {
      "type": "button",
      "label": "巡检 Prompt",
      "icon": "fa fa-file-text-o",
      "actionType": "dialog",
      "dialog": {
        "title": "巡检智能体 Skill Prompt",
        "size": "lg",
        "body": {
          "type": "service",
          "api": "/zenvis/api/v1/dih/skills/agent/agent_inspect/prompt",
          "body": {
            "type": "code",
            "language": "markdown",
            "value": "${value|default:'暂无已启用 Skill'}"
          }
        }
      }
    },
    {
      "type": "button",
      "label": "数据接入 Prompt",
      "icon": "fa fa-file-text-o",
      "actionType": "dialog",
      "dialog": {
        "title": "数据接入智能体 Skill Prompt",
        "size": "lg",
        "body": {
          "type": "service",
          "api": "/zenvis/api/v1/dih/skills/agent/agent_data_access/prompt",
          "body": {
            "type": "code",
            "language": "markdown",
            "value": "${value|default:'暂无已启用 Skill'}"
          }
        }
      }
    },
    {
      "type": "button",
      "label": "刷新",
      "icon": "fa fa-repeat",
      "actionType": "reload",
      "target": "skill_list"
    }
  ],
  "body": [
    {
      "name": "skill_list",
      "type": "crud",
      "api": "/zenvis/api/v1/dih/skills/list",
      "mode": "cards",
      "columnsCount": 3,
      "defaultParams": {
        "page": 1,
        "perPage": 12
      },
      "filter": {
        "title": "搜索",
        "body": [
          {
            "label": "关键词",
            "type": "input-text",
            "name": "keyword",
            "clearable": true,
            "placeholder": "匹配 ID、名称、描述和标签",
            "size": "lg"
          },
          {
            "label": "智能体类型",
            "type": "select",
            "name": "agentType",
            "clearable": true,
            "options": [
              {
                "label": "巡检智能体",
                "value": "agent_inspect"
              },
              {
                "label": "数据接入智能体",
                "value": "agent_data_access"
              }
            ]
          },
          {
            "label": "启用状态",
            "type": "select",
            "name": "enabled",
            "clearable": true,
            "options": [
              {
                "label": "已启用",
                "value": true
              },
              {
                "label": "已停用",
                "value": false
              }
            ]
          }
        ],
        "actions": [
          {
            "type": "reset",
            "label": "重置"
          },
          {
            "type": "submit",
            "level": "primary",
            "label": "查询"
          }
        ]
      },
      "card": {
        "header": {
          "title": "$name",
          "subTitle": "${id}",
          "description": "${description|default:'暂无描述'|truncate:48}"
        },
        "body": [
          {
            "name": "enabled",
            "label": "状态",
            "type": "mapping",
            "map": {
              "true": "<span class='label label-success'>已启用</span>",
              "false": "<span class='label label-default'>已停用</span>",
              "*": "<span class='label label-default'>未知</span>"
            }
          },
          {
            "name": "version",
            "label": "版本",
            "type": "text",
            "placeholder": "-"
          },
          {
            "name": "author",
            "label": "作者",
            "type": "text",
            "placeholder": "-"
          },
          {
            "name": "agent_types",
            "label": "智能体",
            "type": "tpl",
            "tpl": "${agent_types|join:', '|default:'全局可用'}"
          },
          {
            "name": "tags",
            "label": "标签",
            "type": "tpl",
            "tpl": "${tags|join:', '|default:'-'}"
          },
          {
            "name": "entry",
            "label": "入口文件",
            "type": "text",
            "placeholder": "SKILL.md"
          },
          {
            "name": "path",
            "label": "目录",
            "type": "tpl",
            "tpl": "${path|truncate:28}",
            "popOver": {
              "trigger": "hover",
              "position": "left-top",
              "showIcon": false,
              "body": {
                "type": "tpl",
                "tpl": "${path}"
              }
            }
          },
          {
            "name": "update_time",
            "label": "更新时间",
            "type": "text",
            "placeholder": "-"
          }
        ],
        "actionsCount": 3,
        "actions": [
          {
            "type": "button",
            "label": "查看",
            "icon": "fa fa-eye text-info",
            "actionType": "dialog",
            "dialog": {
              "title": "Skill 详情",
              "size": "full",
              "body": {
                "type": "service",
                "api": "/zenvis/api/v1/dih/skills/${id}/view",
                "body": [
                  {
                    "type": "property",
                    "title": "基础信息",
                    "column": 3,
                    "items": [
                      {
                        "label": "Skill ID",
                        "content": "${id}"
                      },
                      {
                        "label": "名称",
                        "content": "${name}"
                      },
                      {
                        "label": "状态",
                        "content": "${enabled ? '已启用' : '已停用'}"
                      },
                      {
                        "label": "版本",
                        "content": "${version|default:'-'}"
                      },
                      {
                        "label": "作者",
                        "content": "${author|default:'-'}"
                      },
                      {
                        "label": "入口文件",
                        "content": "${entry|default:'SKILL.md'}"
                      },
                      {
                        "label": "智能体",
                        "content": "${agent_types|join:', '|default:'全局可用'}"
                      },
                      {
                        "label": "标签",
                        "content": "${tags|join:', '|default:'-'}"
                      },
                      {
                        "label": "目录",
                        "content": "${path}"
                      }
                    ]
                  },
                  {
                    "type": "tabs",
                    "tabsMode": "simple",
                    "tabs": [
                      {
                        "title": "入口内容",
                        "body": {
                          "type": "code",
                          "language": "markdown",
                          "value": "${content|default:''}"
                        }
                      },
                      {
                        "title": "描述",
                        "body": {
                          "type": "markdown",
                          "value": "${description|default:'暂无描述'}"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "启用",
            "icon": "fa fa-play text-success",
            "hiddenOn": "data.enabled",
            "actionType": "ajax",
            "confirmText": "确认启用该 Skill？",
            "api": "post:/zenvis/api/v1/dih/skills/${id}/enable",
            "reload": "skill_list"
          },
          {
            "type": "button",
            "label": "停用",
            "icon": "fa fa-pause text-warning",
            "hiddenOn": "!data.enabled",
            "actionType": "ajax",
            "confirmText": "确认停用该 Skill？",
            "api": "post:/zenvis/api/v1/dih/skills/${id}/disable",
            "reload": "skill_list"
          }
        ]
      }
    }
  ]
}
