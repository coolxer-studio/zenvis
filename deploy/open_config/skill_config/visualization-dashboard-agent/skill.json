{
  "id": "visualization-dashboard-agent",
  "name": "数据大屏",
  "description": "系统内置数据大屏智能体 Skill，通过 DashboardSpec 生成只读深色科技风数据大屏，并完成真实预览与原子发布。",
  "version": "3.0.0",
  "author": "ZenVis",
  "agentTypes": ["agent_visualization_dashboard"],
  "tags": ["builtin", "agent", "visualization", "dashboard", "amis", "html", "echarts"],
  "chat": {
    "enabled": true,
    "label": "数据大屏",
    "icon": "operation",
    "order": 22
  },
  "runtime": {
    "tools": {
      "local": {
        "retrieval": [
          "retrieval_search",
          "retrieval_list_rule",
          "retrieval_list_entity",
          "retrieval_list_attribute",
          "retrieval_list_candidate",
          "retrieval_list_display_entity",
          "retrieval_list_display_attribute",
          "entity_overview",
          "entity_summary",
          "entity_trend",
          "entity_distribution",
          "entity_aggregate",
          "entity_histogram",
          "entity_scatter",
          "entity_value_statistics",
          "entity_relations",
          "entity_relation_timeline",
          "entity_list",
          "entity_view"
        ],
        "dashboard": [
          "visualization_dashboard_list",
          "visualization_dashboard_get",
          "visualization_dashboard_validate",
          "visualization_dashboard_apply"
        ]
      }
    },
    "limits": {
      "maxToolCalls": 32,
      "maxRepeatedFailures": 2,
      "maxToolResultChars": 8000,
      "maxAccumulatedToolResultChars": 64000,
      "maxAccumulatedToolResultTokens": 48000
    }
  },
  "enabled": true,
  "entry": "SKILL.md"
}
