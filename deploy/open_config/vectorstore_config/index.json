                              },
                              {
                                "label": "知识库标签",
                                "content": "${knowledge_base_tags|default:'-'}"
                              },
                              {
                                "label": "数据集",
                                "content": "${dataset_name|default:'-'}"
                              },
                              {
                                "label": "文件名",
