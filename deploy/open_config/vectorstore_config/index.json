                          },
                          {
                            "type": "tabs",
                            "tabsMode": "simple",
                            "tabs": [
                              {
                                "title": "内容",
                                "body": {
                                  "type": "code",
                                  "language": "markdown",
                                  "value": "${text|default:''}"
                                }
                              },
                              {
                                "title": "元数据",
                                "body": {
                                  "type": "json",
                                  "source": "${metadata}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                ],
                "toggled": true
              }
            ]
          }
        }
      ]
    }
  ]
