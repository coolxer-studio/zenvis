{
  "type": "page",
  "title": "网络请求事件列表",
  "remark": "网络请求事件表（zenvis.operation_network_event）",
  "body": [
    {
      "type": "crud",
      "name": "crud-network",
      "primaryField": "zenvis_id",
      "api": "/zenvis/api/v1/entity/operation_network_event/list",
      "autoGenerateFilter": true,
      "defaultParams": {
        "orderBy": "event_time",
        "orderDir": "desc"
      },
      "columns": [
        {
          "name": "id",
          "label": "事件ID",
          "sortable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.operation.detail-network?record_id=${zenvis_id}",
          "body": {
            "type": "tpl",
            "tpl": "${id | default:'-'}"
          },
          "copyable": true
        },
        {
          "name": "user_id",
          "label": "用户ID",
          "sortable": true,
          "copyable": true
        },
        {
          "name": "source_ip",
          "label": "源IP",
          "sortable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.operation.ip-statistics?ip=${source_ip}",
          "body": {
            "type": "tpl",
            "tpl": "${source_ip | default:'-'}"
          },
          "copyable": true
        },
        {
          "name": "target_ip",
          "label": "目标IP",
          "sortable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.operation.ip-statistics?ip=${target_ip}",
          "body": {
            "type": "tpl",
            "tpl": "${target_ip | default:'-'}"
          },
          "copyable": true
        },
        {
          "name": "protocol",
          "label": "协议",
          "sortable": true,
          "searchable": true
        },
        {
          "name": "request_time",
          "label": "请求时间",
          "sortable": true,
          "searchable": {
            "type": "input-datetime-range"
          }
        },
        {
          "name": "response_time",
          "label": "响应时间",
          "sortable": true,
          "searchable": {
            "type": "input-datetime-range"
          }
        },
        {
          "name": "longitude",
          "label": "经度",
          "sortable": true
        },
        {
          "name": "latitude",
          "label": "纬度",
          "sortable": true
        },
        {
          "name": "country",
          "label": "国家",
          "sortable": true,
          "searchable": true
        },
        {
          "name": "province",
          "label": "省份",
          "sortable": true,
          "searchable": true,
          "toggled": false
        },
        {
          "name": "city",
          "label": "城市",
          "sortable": true,
          "searchable": true,
          "toggled": false
        },
        {
          "name": "net_type",
          "label": "网络类型",
          "sortable": true,
          "searchable": true,
          "toggled": false
        },
        {
          "name": "lan_ip",
          "label": "局域网IP",
          "sortable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.operation.ip-statistics?ip=${lan_ip}",
          "body": {
            "type": "tpl",
            "tpl": "${lan_ip | default:'-'}"
          },
          "copyable": true,
          "toggled": false
        },
        {
          "name": "wan_ip",
          "label": "因特网IP",
          "sortable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.operation.ip-statistics?ip=${wan_ip}",
          "body": {
            "type": "tpl",
            "tpl": "${wan_ip | default:'-'}"
          },
          "copyable": true,
          "toggled": false
        },
        {
          "name": "update_time",
          "label": "更新时间",
          "sortable": true,
          "searchable": {
            "type": "input-datetime-range"
          },
          "toggled": false
        },
        {
          "name": "event_time",
          "label": "事件发生时间",
          "sortable": true,
          "searchable": {
            "type": "input-datetime-range"
          },
          "toggled": false
        },
        {
          "type": "operation",
          "label": "操作",
          "fixed": "right",
          "width": 160,
          "buttons": [
            {
              "type": "button-group",
              "buttons": [
                {
                  "type": "button",
                  "label": "查看",
                  "level": "info",
                  "actionType": "link",
                  "link": "/#/service/low-code-page/com.coolxer.plugin.operation.detail-network?record_id=${zenvis_id}"
                },
                {
                  "type": "button",
                  "label": "删除",
                  "level": "danger",
                  "actionType": "ajax",
                  "confirmText": "确认删除这条记录？",
                  "api": "delete:/zenvis/api/v1/entity/operation_network_event/$zenvis_id"
                }
              ]
            }
          ]
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "暂无数据"
    }
  ]
}
