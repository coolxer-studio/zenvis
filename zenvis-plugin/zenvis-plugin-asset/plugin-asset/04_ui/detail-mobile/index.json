{
  "type": "page",
  "title": "移动端资产详情",
  "subTitle": "使用 Zenvis 平台记录 ID 精确查询",
  "toolbar": [
    {
      "type": "button",
      "label": "关闭",
      "actionType": "custom",
      "onEvent": {
        "click": {
          "actions": [
            {
              "actionType": "custom",
              "script": "window.close();"
            }
          ]
        }
      }
    }
  ],
  "body": [
    {
      "type": "alert",
      "level": "warning",
      "showIcon": true,
      "visibleOn": "${!record_id}",
      "body": "详情链接缺少 record_id，无法查询当前记录。"
    },
    {
      "type": "service",
      "api": {
        "method": "get",
        "url": "/zenvis/api/v1/entity/asset_mobile/${record_id}/view",
        "sendOn": "${!!record_id}"
      },
      "messages": {
        "fetchFailed": "移动端资产记录不存在或没有访问权限"
      },
      "body": [
        {
          "type": "property",
          "title": "平台记录",
          "column": 2,
          "items": [
            {
              "label": "平台记录 ID",
              "content": "${zenvis_id | default:'-'}",
              "remark": "Zenvis 自动生成的记录 UUID。",
              "span": 2
            },
            {
              "label": "平台入库时间",
              "content": "${zenvis_insert_time | default:'-'}",
              "remark": "Zenvis 自动记录的实际接收时间。",
              "span": 2
            }
          ]
        },
        {
          "type": "divider"
        },
        {
          "type": "property",
          "title": "资产治理信息",
          "column": 3,
          "items": [
            {
              "label": "设备ID",
              "content": "${id | default:'-'}",
              "remark": "来源系统中的业务资产标识；用于去重、检索和关联，保持为不透明字符串。"
            },
            {
              "label": "来源",
              "content": "${source | default:'-'}",
              "remark": "资产数据来源；取值为 MANUAL（手动录入）、AGENT（Agent 监测）、PROBE（主动探测）、THIRD_PARTY（第三方平台）或 OTHER（其他）。"
            },
            {
              "label": "类型",
              "content": "${type | default:'-'}",
              "remark": "资产业务分类；BUSINESS 表示业务类资产，SUPPORT 表示支撑类资产。"
            },
            {
              "label": "负责人",
              "content": "${owner | default:'-'}",
              "remark": "资产归属；ENTERPRISE 表示企业资产，CUSTOMER 表示终端客户资产。"
            },
            {
              "label": "状态",
              "content": "${status | default:'-'}",
              "remark": "资产生命周期状态；支持 ONLINE、DISABLED、OFFLINE、DELETED。"
            },
            {
              "label": "标签",
              "content": "${label | default:'-'}",
              "remark": "业务标签列表"
            },
            {
              "label": "可访问性",
              "content": "${access | default:'-'}",
              "remark": "是否允许访问：1 表示开放，0 表示不开放。"
            },
            {
              "label": "重要等级",
              "content": "${level | default:'-'}",
              "remark": "资产重要等级；从 AUXILIARY、GENERAL、MINOR、IMPORTANT 到 CRITICAL 逐级提高。"
            },
            {
              "label": "风险等级",
              "content": "${risk | default:'-'}",
              "remark": "当前风险等级；支持 NONE、LOW、MEDIUM、HIGH、EXTREME。"
            },
            {
              "label": "风险详情",
              "content": "${risk_info | default:'-'}",
              "remark": "风险描述"
            },
            {
              "label": "更新时间",
              "content": "${update_time | default:'-'}",
              "remark": "资产在来源系统中的最后更新时间，精确到毫秒。"
            },
            {
              "label": "入库时间",
              "content": "${insert_time | default:'-'}",
              "remark": "业务数据声明的入库时间，精确到毫秒；平台实际接收时间请使用 zenvis_insert_time。"
            }
          ]
        },
        {
          "type": "divider"
        },
        {
          "type": "property",
          "title": "资产详细属性",
          "column": 3,
          "items": [
            {
              "label": "区域代码",
              "content": "${area_code | default:'-'}",
              "remark": "行政区域代码"
            },
            {
              "label": "国家",
              "content": "${country | default:'-'}",
              "remark": "国家"
            },
            {
              "label": "省份",
              "content": "${province | default:'-'}",
              "remark": "省/州"
            },
            {
              "label": "城市",
              "content": "${city | default:'-'}",
              "remark": "城市"
            },
            {
              "label": "区县",
              "content": "${county | default:'-'}",
              "remark": "区县"
            },
            {
              "label": "扩展信息",
              "content": "${info | default:'-'}",
              "remark": "其他 JSON 扩展信息"
            },
            {
              "label": "网络类型",
              "content": "${net_type | default:'-'}",
              "remark": "网络类型"
            },
            {
              "label": "内网IP",
              "content": "${lan_ip | default:'-'}",
              "remark": "内网IPv4地址"
            },
            {
              "label": "外网IP",
              "content": "${wan_ip | default:'-'}",
              "remark": "外网IPv4地址"
            },
            {
              "label": "品牌",
              "content": "${brand | default:'-'}",
              "remark": "设备品牌"
            },
            {
              "label": "型号",
              "content": "${model | default:'-'}",
              "remark": "设备型号"
            },
            {
              "label": "厂商",
              "content": "${manufacturer | default:'-'}",
              "remark": "设备制造商"
            },
            {
              "label": "系统名称",
              "content": "${system_name | default:'-'}",
              "remark": "操作系统名称"
            },
            {
              "label": "系统版本",
              "content": "${system_version | default:'-'}",
              "remark": "操作系统版本"
            },
            {
              "label": "AndroidID",
              "content": "${android_id | default:'-'}",
              "remark": "Android设备唯一ID"
            },
            {
              "label": "BuildID",
              "content": "${build_id | default:'-'}",
              "remark": "系统构建ID"
            },
            {
              "label": "蓝牙MAC",
              "content": "${bluetooth_mac | default:'-'}",
              "remark": "蓝牙MAC地址"
            },
            {
              "label": "显示信息",
              "content": "${display_info | default:'-'}",
              "remark": "屏幕分辨率/密度"
            },
            {
              "label": "应用模式",
              "content": "${app_mode | default:'-'}",
              "remark": "应用运行模式（如调试/生产）"
            },
            {
              "label": "指令集1",
              "content": "${instruction_set1 | default:'-'}",
              "remark": "主要CPU指令集"
            },
            {
              "label": "设备指纹",
              "content": "${device_fingerprint | default:'-'}",
              "remark": "设备指纹哈希"
            },
            {
              "label": "主机名",
              "content": "${hostname | default:'-'}",
              "remark": "设备主机名"
            },
            {
              "label": "陀螺仪信息",
              "content": "${gyroscope_info | default:'-'}",
              "remark": "陀螺仪传感器信息"
            },
            {
              "label": "地理位置",
              "content": "${location | default:'-'}",
              "remark": "地理位置描述"
            },
            {
              "label": "蜂窝区域码",
              "content": "${cell_area_code | default:'-'}",
              "remark": "基站区域码"
            },
            {
              "label": "邻近基站数",
              "content": "${nearby_cell_count | default:'-'}",
              "remark": "检测到的邻近基站数量"
            },
            {
              "label": "Bootloader",
              "content": "${bootloader | default:'-'}",
              "remark": "Bootloader版本"
            },
            {
              "label": "设备形态",
              "content": "${device_form | default:'-'}",
              "remark": "设备形态（如手机/平板/手表）"
            },
            {
              "label": "屏幕分辨率",
              "content": "${screen_resolution | default:'-'}",
              "remark": "屏幕分辨率（如1080x1920）"
            },
            {
              "label": "OS名称",
              "content": "${os_name | default:'-'}",
              "remark": "操作系统名称（Android/iOS）"
            },
            {
              "label": "IMEI",
              "content": "${imei | default:'-'}",
              "remark": "国际移动设备识别码"
            },
            {
              "label": "IMSI",
              "content": "${imsi | default:'-'}",
              "remark": "国际移动用户识别码"
            },
            {
              "label": "网络MAC",
              "content": "${network_mac | default:'-'}",
              "remark": "以太网/Wi-Fi MAC地址"
            },
            {
              "label": "设备信息",
              "content": "${device_info | default:'-'}",
              "remark": "设备详情JSON"
            },
            {
              "label": "SDK版本",
              "content": "${sdk_version | default:'-'}",
              "remark": "探针SDK版本"
            },
            {
              "label": "启动信息",
              "content": "${system_boot | default:'-'}",
              "remark": "系统启动信息"
            },
            {
              "label": "序列号",
              "content": "${serial_number | default:'-'}",
              "remark": "设备序列号"
            },
            {
              "label": "硬件名称",
              "content": "${hardware_name | default:'-'}",
              "remark": "硬件名称"
            },
            {
              "label": "指令集2",
              "content": "${instruction_set2 | default:'-'}",
              "remark": "次要CPU指令集"
            },
            {
              "label": "主板信息",
              "content": "${motherboard_info | default:'-'}",
              "remark": "主板信息"
            },
            {
              "label": "构建日期",
              "content": "${build_date | default:'-'}",
              "remark": "系统构建日期"
            },
            {
              "label": "时区",
              "content": "${timezone | default:'-'}",
              "remark": "系统时区"
            },
            {
              "label": "Wi-Fi MAC",
              "content": "${wifi_mac | default:'-'}",
              "remark": "Wi-Fi MAC地址"
            },
            {
              "label": "基站ID",
              "content": "${cell_id | default:'-'}",
              "remark": "当前基站ID"
            },
            {
              "label": "运营商类型",
              "content": "${carrier_type | default:'-'}",
              "remark": "运营商类型（移动/联通/电信/国际）"
            }
          ]
        }
      ]
    }
  ]
}
