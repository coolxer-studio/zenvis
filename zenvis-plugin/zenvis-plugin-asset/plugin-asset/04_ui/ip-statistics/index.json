{
  "type": "page",
  "title": "资产 IP 命中调查",
  "remark": "在同一实体的内网 IP 与外网 IP 字段间执行 OR 匹配，每条资产记录最多计数一次。",
  "body": [
    {
      "type": "alert",
      "level": "info",
      "body": "支持主机、PC、IoT 和移动端资产。可从检索结果中的 IP 链接进入，也可手工输入 IPv4 地址。"
    },
    {
      "type": "form",
      "name": "asset-ip-search-form",
      "mode": "inline",
      "target": "asset-ip-statistics-service",
      "wrapWithPanel": true,
      "data": {"ip": "${ip}"},
      "body": [
        {
          "type": "input-text",
          "name": "ip",
          "label": "IP 地址",
          "placeholder": "例如 192.168.1.10",
          "required": true,
          "clearable": true,
          "size": "lg"
        }
      ],
      "actions": [
        {"type": "submit", "label": "查询", "level": "primary"},
        {"type": "reset", "label": "清空"}
      ]
    },
    {
      "type": "service",
      "name": "asset-ip-statistics-service",
      "initFetchOn": "!!this.ip",
      "api": {
        "method": "post",
        "url": "/zenvis/api/v1/entity/value-statistics/query",
        "data": {
          "focus_value": "${ip}",
          "mappings": [
            {
              "entity": "asset_host",
              "label": "主机资产",
              "match_fields": ["lan_ip", "wan_ip"],
              "time_field": "zenvis_insert_time",
              "criteria_list": [],
              "criteria_logic": "or"
            },
            {
              "entity": "asset_pc",
              "label": "PC 终端资产",
              "match_fields": ["lan_ip", "wan_ip"],
              "time_field": "zenvis_insert_time",
              "criteria_list": [],
              "criteria_logic": "or"
            },
            {
              "entity": "asset_iot",
              "label": "IoT 设备资产",
              "match_fields": ["lan_ip", "wan_ip"],
              "time_field": "zenvis_insert_time",
              "criteria_list": [],
              "criteria_logic": "or"
            },
            {
              "entity": "asset_mobile",
              "label": "移动端资产",
              "match_fields": ["lan_ip", "wan_ip"],
              "time_field": "zenvis_insert_time",
              "criteria_list": [],
              "criteria_logic": "or"
            }
          ],
          "time_range": {"preset": "ALL_TIME"}
        }
      },
      "messages": {
        "fetchFailed": "IP 统计查询失败，请检查地址、权限或服务状态"
      },
      "body": [
        {
          "type": "cards",
          "source": "${result.rows}",
          "placeholder": "未查询到匹配资产",
          "card": {
            "header": {"title": "${label}", "subTitle": "匹配字段：${match_fields}"},
            "body": [
              {
                "type": "property",
                "column": 2,
                "items": [
                  {"label": "目标 IP", "content": "${value}"},
                  {"label": "命中资产数", "content": "${count}"}
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
