{
  "type": "page",
  "title": "HET-WAF 原始事件详情",
  "subTitle": "展示未套用固定规则字段模型的 HET-WAF 原始日志",
  "body": [
    {
      "type": "alert",
      "level": "warning",
      "showIcon": true,
      "visibleOn": "${!record_id}",
      "body": "详情链接缺少 Zenvis 内置记录 ID，无法查询当前记录。"
    },
    {
      "type": "service",
      "api": {
        "method": "get",
        "url": "/zenvis/api/v1/entity/het_waf_2516p_raw_event/${record_id}/view",
        "sendOn": "${!!record_id}"
      },
      "body": [
        {
          "type": "property",
          "title": "事件信息",
          "column": 3,
          "items": [
            {"label": "平台记录 ID", "content": "${zenvis_id | default:'-'}", "span": 2},
            {"label": "入库时间", "content": "${zenvis_insert_time | default:'-'}"},
            {"label": "事件时间", "content": "${syslog_timestamp | default:'-'}"},
            {"label": "设备时间", "content": "${device_time | default:'-'}"},
            {"label": "事件类型", "content": "${event_type | default:'-'}"},
            {"label": "Syslog 应用名", "content": "${syslog_appname | default:'-'}"},
            {"label": "Syslog Facility", "content": "${syslog_facility | default:'-'}"},
            {"label": "Syslog 级别", "content": "${syslog_severity | default:'-'}"},
            {"label": "Syslog Host", "content": "${syslog_host | default:'-'}"},
            {"label": "Syslog 主机名", "content": "${syslog_hostname | default:'-'}"},
            {"label": "Syslog 来源 IP", "content": "${syslog_source_ip | default:'-'}"},
            {"label": "Syslog 来源类型", "content": "${syslog_source_type | default:'-'}"}
          ]
        },
        {
          "type": "panel",
          "title": "Syslog 原始消息",
          "body": {
            "type": "tpl",
            "tpl": "<pre style='margin:0;max-height:520px;overflow:auto;white-space:pre-wrap;word-break:break-all;padding:16px;border-radius:8px;background:#101828;color:#e4e7ec'>${syslog_message || '-'}</pre>"
          }
        }
      ]
    }
  ]
}
