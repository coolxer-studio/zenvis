{
  "entity": [
    {
      "id": 9301,
      "name": "infra_metric_sample",
      "label": "基础设施指标样本",
      "description": "Zenvis 部署内 MySQL、Redis、Redis-Stack、Kafka、ClickHouse 与 MinIO 的 Prometheus 指标样本。每条记录对应一次抓取中的一个指标序列：metric_name 为 Prometheus 指标名，metric_value 为该序列在 observed_at 时刻的值，labels 保存该序列的标签集合。数据链路为 prometheus_scrape → Kafka 主题 infra-metrics-raw → Kafka 消费入库任务 → ClickHouse。插件只保留一组有界的关注指标，避免将 Exporter 内部高基数指标全部落库。",
      "table_name": "infra_metric_sample",
      "data_source": "clickhouse",
      "sort_column": "observed_at",
      "auto_create": {
        "engine": "MergeTree()",
        "order_by": ["service", "metric_name", "observed_at"],
        "partition_by": "toYYYYMM(zenvis_insert_time)",
        "ttl": {
          "column": "zenvis_insert_time",
          "expire_after": 30,
          "unit": "DAY"
        }
      }
    }
  ],
  "attribute": [
    {
      "id": 930101,
      "entity": "infra_metric_sample",
      "name": "sample_id",
      "label": "样本指纹",
      "description": "由指标名、抓取端点、实例、抓取时间与标签集合计算的 SHA-256 指纹。Kafka 为至少一次投递语义，重放或重试可能产生重复样本，可用该字段去重；它不是数据库主键。",
      "column_name": "sample_id",
      "column_type": "String",
      "operators": ["equal", "notequal", "isnull", "isnotnull", "in", "match"],
      "display_selected": true,
      "must_candidate": false,
      "copyable": true,
      "auto_complete": false,
      "link_template": "/#/service/low-code-page/com.coolxer.plugin.infra.monitor.detail-metric?record_id={zenvis_id}"
    },
    {
      "id": 930102,
      "entity": "infra_metric_sample",
      "name": "observed_at",
      "label": "抓取时刻",
      "description": "Prometheus 抓取该指标样本的时间，已转换为 Asia/Shanghai 的毫秒精度时间。该字段是本实体的主时间字段。",
      "column_name": "observed_at",
      "column_type": "DateTime64(3)",
      "operators": ["equal", "notequal", "isnull", "isnotnull", "greatthan", "greatequalthan", "lessthan", "lessequalthan", "between"],
      "display_selected": true,
      "must_candidate": false,
      "copyable": false,
      "auto_complete": false
    },
    {
      "id": 930103,
