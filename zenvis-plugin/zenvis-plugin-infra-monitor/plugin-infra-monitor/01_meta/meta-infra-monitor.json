    {
      "id": 930110,
      "entity": "infra_metric_sample",
      "name": "instance",
      "label": "抓取实例",
      "description": "Prometheus 抓取源记录的实例标签（instance），通常为被采集服务的容器名与端口，例如 mysql-service:3306。对于 Redis-Stack 的 Exporter 多目标抓取，instance 为 Exporter 自身（zenvis-service-exporters:9121），实际被采集目标记录在 endpoint 的 target 查询参数中。",
      "column_name": "instance",
      "column_type": "String",
      "operators": ["equal", "notequal", "isnull", "isnotnull", "in", "match"],
      "display_selected": true,
      "must_candidate": false,
      "copyable": true,
      "auto_complete": false
    },
    {
      "id": 930111,
      "entity": "infra_metric_sample",
      "name": "labels",
      "label": "指标标签",
      "description": "Prometheus 指标序列的标签集合，以 JSON 对象保存：{\"tags\": {...}}。包含 endpoint、instance 以及来源指标自身的标签，例如 Kafka 的 topic、partition、consumergroup。不同服务与指标的标签集合不同，读取时应按 JSON 结构解析。",
      "column_name": "labels",
      "column_type": "json",
      "display_type": "json",
      "operators": ["equal", "notequal", "isnull", "isnotnull"],
      "display_selected": false,
