      "name": "metric_kind",
      "label": "指标类型",
      "description": "来源指标类型：counter（累计计数器）或 gauge（瞬时仪表）。用于区分累计值的变化趋势与瞬时状态。",
      "column_name": "metric_kind",
      "column_type": "String",
