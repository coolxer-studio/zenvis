      "name": "metric_value",
      "label": "指标值",
      "description": "该 Prometheus 指标序列在当前抓取时刻的数值。计数器返回累计值，仪表盘/Gauge 返回瞬时值；单位由指标语义决定，不在本字段中统一换算。",
      "column_name": "metric_value",
      "column_type": "Float64",
      "operators": ["equal", "notequal", "isnull", "isnotnull", "in", "greatthan", "greatequalthan", "lessthan", "lessequalthan", "between"],
