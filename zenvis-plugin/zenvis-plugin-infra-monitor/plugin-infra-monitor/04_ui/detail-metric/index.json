{
  "type": "page",
  "title": "基础设施指标样本详情",
  "subTitle": "使用 Zenvis 平台记录 ID 精确查询",
  "toolbar": [
    {
      "type": "button",
      "label": "关闭",
      "actionType": "custom",
      "onEvent": {
        "click": {
          "actions": [
            {
              "actionType": "custom",
              "script": "window.close();"
            }
          ]
        }
      }
    }
  ],
  "body": [
    {
      "type": "alert",
      "level": "warning",
      "showIcon": true,
      "visibleOn": "${!record_id}",
      "body": "详情链接缺少 record_id，无法查询当前记录。"
    },
    {
      "type": "service",
      "api": {
        "method": "get",
        "url": "/zenvis/api/v1/entity/infra_metric_sample/${record_id}/view",
        "sendOn": "${!!record_id}"
      },
      "messages": {
        "fetchFailed": "记录不存在或没有访问权限"
      },
      "body": [
        {
          "type": "alert",
          "level": "info",
          "showIcon": true,
          "body": "本记录是 Prometheus 指标序列的一次采样。counter 为累计值，gauge 为瞬时值；单位由指标语义决定。Kafka 至少一次投递可能产生重复样本，可结合样本指纹去重。"
        },
        {
          "type": "property",
          "title": "样本信息",
          "column": 3,
          "items": [
            {
              "label": "平台记录 ID",
              "content": "${zenvis_id | default:'-'}",
              "remark": "Zenvis 自动生成的记录 UUID。"
            },
            {
              "label": "平台入库时间",
              "content": "${zenvis_insert_time | default:'-'}",
              "remark": "Zenvis 实际接收时间。"
            },
            {
              "label": "样本指纹",
              "content": "${sample_id | default:'-'}",
              "remark": "SHA-256 指纹，可用于重放去重。"
            },
            {
              "label": "抓取时刻",
              "content": "${observed_at | default:'-'}",
              "remark": "Prometheus 抓取时间（Asia/Shanghai）。"
            },
            {
              "label": "服务标识",
              "content": "${service | default:'-'}",
              "remark": "mysql / redis / redis-stack / kafka / clickhouse / minio。"
            },
            {
              "label": "服务名称",
              "content": "${service_name | default:'-'}",
              "remark": "服务标识对应的易读名称。"
            },
            {
              "label": "指标名称",
              "content": "${metric_name | default:'-'}",
              "remark": "Prometheus 指标名。"
            },
            {
              "label": "指标值",
              "content": "${metric_value | default:'-'}",
              "remark": "当前抓取时刻的数值。"
            },
            {
              "label": "指标类型",
              "content": "${metric_kind | default:'-'}",
              "remark": "counter 或 gauge。"
            },
            {
              "label": "采集来源",
              "content": "${source_type | default:'-'}",
              "remark": "exporter 或 native。"
            },
            {
              "label": "抓取实例",
              "content": "${instance | default:'-'}",
              "remark": "Prometheus instance 标签。"
            },
            {
              "label": "抓取端点",
              "content": "${endpoint | default:'-'}",
              "remark": "实际抓取的完整 URL。"
            }
          ]
        },
        {
          "type": "panel",
          "title": "指标标签（labels）",
          "body": {
            "type": "json",
            "value": "${labels|raw}",
            "levelExpand": 2,
            "mutable": false,
            "displayDataTypes": false,
            "enableClipboard": true
          }
        }
      ]
    }
  ]
}
