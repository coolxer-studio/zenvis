{
  "entity": [
    {
      "id": 9401,
      "name": "lab_access_event",
      "label": "实验室访问事件",
      "description": "用于演示字段检索、详情链接、IP 调查和多实体聚合的合成访问事件",
      "table_name": "lab_access_event",
      "data_source": "clickhouse",
      "sort_column": "occurred_at",
      "auto_create": {
        "engine": "MergeTree()",
        "order_by": ["occurred_at", "event_id"],
        "partition_by": "toYYYYMM(zenvis_insert_time)"
      }
    },
    {
      "id": 9402,
      "name": "lab_risk_signal",
      "label": "实验室风险线索",
      "description": "用于演示状态筛选、数值字段、JSON 详情和跨实体 IP 关联的合成风险线索",
      "table_name": "lab_risk_signal",
      "data_source": "clickhouse",
      "sort_column": "detected_at",
      "auto_create": {
        "engine": "MergeTree()",
        "order_by": ["detected_at", "signal_id"],
        "partition_by": "toYYYYMM(zenvis_insert_time)"
      }
    }
  ],
