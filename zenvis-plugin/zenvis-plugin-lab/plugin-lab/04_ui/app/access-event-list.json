{
  "type": "page",
  "title": "实验室访问事件",
  "subTitle": "Meta 字典、数组、JSON、详情跳转与 IP 调查链接的综合示例",
  "body": [
    {
      "type": "alert",
      "level": "info",
      "showIcon": true,
      "body": "数据来自合成访问事件。点击事件 ID 打开详情，点击源 IP 或目的 IP 进入跨实体 IP 调查。"
    },
    {
      "type": "crud",
      "name": "lab-access-event-crud",
      "api": "/zenvis/api/v1/entity/lab_access_event/list",
      "autoGenerateFilter": true,
      "defaultParams": {
        "orderBy": "occurred_at",
        "orderDir": "desc"
      },
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "暂无访问事件；安装演示生成任务后约 5 秒出现数据",
      "columns": [
        {
          "name": "event_id",
          "label": "事件 ID",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.lab.detail-access-event?record_id=${zenvis_id|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${event_id}"
          }
        },
        {
          "name": "occurred_at",
          "label": "发生时间",
          "sortable": true,
          "searchable": {
            "type": "input-datetime-range",
            "name": "occurred_at"
          }
        },
        {
          "name": "actor",
          "label": "访问主体",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "action",
          "label": "动作",
          "searchable": {
            "type": "select",
            "name": "action",
            "options": [
              {"label": "登录 login", "value": "login"},
              {"label": "读取 read", "value": "read"},
              {"label": "写入 write", "value": "write"},
              {"label": "执行 execute", "value": "execute"},
              {"label": "共享 share", "value": "share"}
            ]
          }
        },
        {
          "name": "result",
          "label": "结果",
          "searchable": {
            "type": "select",
            "name": "result",
            "options": [
              {"label": "成功 success", "value": "success"},
              {"label": "拒绝 denied", "value": "denied"},
              {"label": "失败 failed", "value": "failed"}
            ]
          }
        },
        {
          "name": "severity",
          "label": "风险级别",
          "searchable": {
            "type": "select",
            "name": "severity",
            "options": [
              {"label": "提示 info", "value": "info"},
              {"label": "低 low", "value": "low"},
              {"label": "中 medium", "value": "medium"},
              {"label": "高 high", "value": "high"}
            ]
          }
        },
        {
          "name": "source_ip",
          "label": "源 IP",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.lab.ip-investigation?ip=${source_ip|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${source_ip}"
          }
        },
        {
          "name": "destination_ip",
          "label": "目的 IP",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.lab.ip-investigation?ip=${destination_ip|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${destination_ip}"
          }
        },
        {
          "name": "resource",
          "label": "资源路径",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "trace_id",
          "label": "链路 ID",
          "copyable": true,
          "toggled": false
        },
        {
          "name": "tags",
          "label": "标签",
          "type": "text",
          "toggled": true
        },
        {
          "name": "detail",
          "label": "请求详情",
          "toggled": false,
          "type": "tpl",
          "tpl": "<span class=\"text-truncate d-inline-block\" style=\"max-width: 220px\">${detail}</span>",
          "popOver": {
            "trigger": "hover",
            "body": {
              "type": "json",
              "value": "${detail|raw}",
              "levelExpand": 2,
              "mutable": false,
              "displayDataTypes": false,
              "enableClipboard": true
            }
          }
        },
        {
          "type": "operation",
          "label": "操作",
          "buttons": [
            {
              "type": "button",
              "label": "详情",
              "level": "link",
              "actionType": "url",
              "url": "/#/service/low-code-page/com.coolxer.plugin.lab.detail-access-event?record_id=${zenvis_id|url_encode}",
              "blank": true
            }
          ]
        }
      ]
    }
  ]
}
