{
  "type": "page",
  "title": "实验室风险线索",
  "subTitle": "状态字典、数值评分、JSON 证据与跨实体 IP 关联示例",
  "body": [
    {
      "type": "alert",
      "level": "warning",
      "showIcon": true,
      "body": "风险线索为合成数据，仅用于演示状态筛选、数值字段和 IP 调查查询方式，不代表真实因果关系。"
    },
    {
      "type": "crud",
      "name": "lab-risk-signal-crud",
      "api": "/zenvis/api/v1/entity/lab_risk_signal/list",
      "autoGenerateFilter": true,
      "defaultParams": {
        "orderBy": "detected_at",
        "orderDir": "desc"
      },
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "暂无风险线索；安装演示生成任务后约 9 秒出现数据",
      "columns": [
        {
          "name": "signal_id",
          "label": "线索 ID",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.lab.detail-risk-signal?record_id=${zenvis_id|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${signal_id}"
          }
        },
        {
          "name": "detected_at",
          "label": "发现时间",
          "sortable": true,
          "searchable": {
            "type": "input-datetime-range",
            "name": "detected_at"
          }
        },
        {
          "name": "rule_code",
          "label": "规则编码",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "severity",
          "label": "风险级别",
          "searchable": {
            "type": "select",
            "name": "severity",
            "options": [
              {"label": "低 low", "value": "low"},
              {"label": "中 medium", "value": "medium"},
              {"label": "高 high", "value": "high"},
              {"label": "严重 critical", "value": "critical"}
            ]
          }
        },
        {
          "name": "status",
          "label": "处置状态",
          "searchable": {
            "type": "select",
            "name": "status",
            "options": [
              {"label": "待处理 open", "value": "open"},
              {"label": "调查中 investigating", "value": "investigating"},
              {"label": "已解决 resolved", "value": "resolved"},
              {"label": "已接受 accepted", "value": "accepted"}
            ]
          }
        },
        {
          "name": "risk_score",
          "label": "风险分",
          "sortable": true
        },
        {
          "name": "source_ip",
          "label": "源 IP",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.lab.ip-investigation?ip=${source_ip|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${source_ip}"
          }
        },
        {
          "name": "destination_ip",
          "label": "目的 IP",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.lab.ip-investigation?ip=${destination_ip|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${destination_ip}"
          }
        },
        {
          "name": "summary",
          "label": "线索摘要",
          "searchable": true
        },
        {
          "name": "tags",
          "label": "标签",
          "type": "text"
        },
        {
          "name": "detail",
          "label": "线索详情",
          "toggled": false,
          "type": "tpl",
          "tpl": "<span class=\"text-truncate d-inline-block\" style=\"max-width: 220px\">${detail}</span>",
          "popOver": {
            "trigger": "hover",
            "body": {
              "type": "json",
              "value": "${detail|raw}",
              "levelExpand": 2,
              "mutable": false,
              "displayDataTypes": false,
              "enableClipboard": true
            }
          }
        },
        {
          "type": "operation",
          "label": "操作",
          "buttons": [
            {
              "type": "button",
              "label": "详情",
              "level": "link",
              "actionType": "url",
              "url": "/#/service/low-code-page/com.coolxer.plugin.lab.detail-risk-signal?record_id=${zenvis_id|url_encode}",
              "blank": true
            }
          ]
        }
      ]
    }
  ]
}
