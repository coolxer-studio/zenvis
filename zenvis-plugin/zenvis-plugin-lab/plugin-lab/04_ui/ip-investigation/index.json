{
  "type": "page",
  "title": "实验室 IP 关联调查",
  "remark": "跨访问事件与风险线索，对源 IP / 目的 IP 执行 OR 匹配；同一实体中的同一记录最多计数一次。",
  "body": [
    {
      "type": "alert",
      "level": "info",
      "showIcon": true,
      "body": "可从列表中的 IP 链接进入，也可手工输入 IPv4 地址。查询结果只反映本插件的合成数据。"
    },
    {
      "type": "form",
      "name": "lab-ip-search-form",
      "mode": "inline",
      "target": "lab-ip-statistics-service",
      "wrapWithPanel": true,
      "data": {
        "ip": "${params.ip}"
      },
      "body": [
        {
          "type": "input-text",
          "name": "ip",
          "label": "IP 地址",
          "placeholder": "例如 10.24.8.15",
          "required": true,
          "clearable": true,
          "size": "lg"
        }
      ],
      "actions": [
        {
          "type": "submit",
          "label": "查询关联",
          "level": "primary"
        },
        {
          "type": "reset",
          "label": "清空"
        }
      ]
    },
    {
      "type": "service",
      "name": "lab-ip-statistics-service",
      "initFetchOn": "!!(ip || params.ip)",
      "api": {
        "method": "post",
        "url": "/zenvis/api/v1/entity/value-statistics/query",
        "data": {
          "focus_value": "${ip || params.ip}",
          "time_range": {
            "preset": "ALL_TIME"
          },
          "mappings": [
            {
              "entity": "lab_access_event",
              "label": "访问事件",
              "match_fields": ["source_ip", "destination_ip"],
              "time_field": "occurred_at",
              "criteria_list": [],
              "criteria_logic": "or"
            },
            {
              "entity": "lab_risk_signal",
              "label": "风险线索",
              "match_fields": ["source_ip", "destination_ip"],
              "time_field": "detected_at",
              "criteria_list": [],
              "criteria_logic": "or"
            }
          ]
        },
        "adaptor": "var raw=payload&&payload.data&&payload.data.result?payload.data:(payload&&payload.result?payload:{}),r=raw.result||{},rows=Array.isArray(r.rows)?r.rows:[];var out={focus_value:String(r.focus_value||''),total:Number(r.total||0),matched_entities:rows.filter(function(row){return Number(row.count||0)>0;}).length,rows:rows.map(function(row){return {entity:String(row.entity||''),label:String(row.label||row.entity||''),match_fields:Array.isArray(row.match_fields)?row.match_fields:[],value:String(row.value||''),count:Number(row.count||0)};})};return {status:0,msg:'',data:out};"
      },
      "messages": {
        "fetchFailed": "IP 统计查询失败，请核对地址、登录状态或服务可用性"
      },
      "body": [
        {
          "type": "alert",
          "level": "info",
          "showIcon": true,
          "visibleOn": "${!focus_value}",
          "body": "输入 IP 后点击“查询关联”。"
        },
        {
          "type": "grid",
          "gap": "md",
          "columns": [
            {
              "md": 4,
              "body": {
                "type": "panel",
                "title": "查询 IP",
                "body": "<div style=\"font-size:22px;font-weight:700;word-break:break-all\">${focus_value || '-'}</div><div style=\"color:#64748b\">精确匹配，不使用模糊查询</div>"
              }
            },
            {
              "md": 4,
              "body": {
                "type": "panel",
                "title": "命中记录总数",
                "body": "<div style=\"font-size:28px;font-weight:700\">${total || 0}</div><div style=\"color:#64748b\">两个实体计数之和</div>"
              }
            },
            {
              "md": 4,
              "body": {
                "type": "panel",
                "title": "命中实体类型",
                "body": "<div style=\"font-size:28px;font-weight:700\">${matched_entities || 0} / 2</div><div style=\"color:#64748b\">访问事件、风险线索</div>"
              }
            }
          ]
        },
        {
          "type": "table",
          "source": "${rows}",
          "title": "实体命中明细",
          "placeholder": "未查询到匹配记录。可尝试演示数据中的 10.24.8.15、10.24.16.20 或 192.168.50.12。",
          "columns": [
            {"name": "label", "label": "实体", "width": 160},
            {"name": "entity", "label": "实体编码", "width": 180, "copyable": true},
            {"name": "match_fields", "label": "匹配字段"},
            {"name": "value", "label": "目标 IP", "width": 180, "copyable": true},
            {"name": "count", "label": "命中记录数", "width": 130}
          ]
        },
        {
          "type": "tpl",
          "tpl": "<div style=\"margin-top:12px;color:#64748b;font-size:12px\">同一实体内的源 IP 和目的 IP 使用 OR 条件，因此一条记录即使同时匹配两个字段也只计数一次。不同实体分别计数后求和。</div>"
        }
      ]
    }
  ]
}
