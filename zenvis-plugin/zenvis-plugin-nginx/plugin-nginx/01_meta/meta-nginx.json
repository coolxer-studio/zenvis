{
  "entity": [
    {
      "id": 7001,
      "name": "nginx_access_log",
      "label": "Nginx访问日志",
      "description": "Nginx 访问日志，记录客户端请求的 IP、方法、URI、状态码、响应大小、User-Agent 等信息，以 JSON 格式采集",
      "table_name": "zenvis.nginx_access_log",
      "data_source": "clickhouse",
      "auto_create": {
        "engine": "MergeTree()",
        "order_by": ["time_local", "remote_addr"],
        "partition_by": "toYYYYMM(zenvis_insert_time)"
      },
      "sort_column": "time_local"
    },
    {
      "id": 7002,
      "name": "nginx_error_log",
      "label": "Nginx错误日志",
      "description": "Nginx 错误日志，记录服务运行中的告警、异常和严重错误，包含级别、进程 PID、连接 ID 和错误消息",
      "table_name": "zenvis.nginx_error_log",
      "data_source": "clickhouse",
      "auto_create": {
        "engine": "MergeTree()",
        "order_by": ["log_time", "level"],
        "partition_by": "toYYYYMM(zenvis_insert_time)"
      },
      "sort_column": "log_time"
    }
  ],
