{
  "type": "page",
  "title": "Nginx错误日志详情",
  "subTitle": "使用 Zenvis 平台记录 ID 精确查询",
  "toolbar": [
    {
      "type": "button",
      "label": "关闭",
      "actionType": "custom",
      "onEvent": {
        "click": {
          "actions": [
            {
              "actionType": "custom",
              "script": "window.close();"
            }
          ]
        }
      }
    }
  ],
  "body": [
    {
      "type": "alert",
      "level": "warning",
      "showIcon": true,
      "visibleOn": "${!record_id}",
      "body": "详情链接缺少 record_id，无法查询当前记录。"
    },
    {
      "type": "service",
      "api": {
        "method": "get",
        "url": "/zenvis/api/v1/entity/nginx_error_log/${record_id}/view",
        "sendOn": "${!!record_id}"
      },
      "messages": {
        "fetchFailed": "记录不存在或没有访问权限"
      },
      "body": [
        {
          "type": "property",
          "title": "错误日志属性",
          "column": 3,
          "items": [
            {
              "label": "平台记录 ID",
              "content": "${zenvis_id | default:'-'}",
              "remark": "Zenvis 自动生成的记录 UUID。"
            },
            {
              "label": "平台入库时间",
              "content": "${zenvis_insert_time | default:'-'}",
              "remark": "Zenvis 实际接收时间。"
            },
            {
              "label": "日志时间",
              "content": "${log_time | default:'-'}",
              "remark": "Nginx 错误日志记录的时间。"
            },
            {
              "label": "日志级别",
              "content": "${level | default:'-'}",
              "remark": "错误日志级别：debug、info、notice、warn、error、crit、alert、emerg。"
            },
            {
              "label": "进程PID",
              "content": "${pid | default:'-'}",
              "remark": "Nginx worker 进程 PID。"
            },
            {
              "label": "线程ID",
              "content": "${tid | default:'-'}",
              "remark": "Nginx worker 线程 ID。"
            },
            {
              "label": "连接ID",
              "content": "${connection_id | default:'-'}",
              "remark": "Nginx 连接序号，用于关联同一连接的多个日志事件。"
            },
            {
              "label": "客户端IP",
              "content": "${client_addr | default:'-'}",
              "remark": "触发错误的客户端 IP 地址。"
            },
            {
              "label": "服务端地址",
              "content": "${server_addr | default:'-'}",
              "remark": "Nginx 服务器接收请求的地址。"
            },
            {
              "label": "错误消息",
              "content": "${message | default:'-'}",
              "remark": "错误日志消息正文，包含错误描述和相关上下文信息。"
            }
          ]
        }
      ]
    }
  ]
}
