{
  "type": "page",
  "title": "Nginx 错误日志",
  "remark": "按日志时间倒序展示，支持分页、排序、字段筛选和详情跳转。",
  "body": [
    {
      "name": "nginx_error_log_list",
      "type": "crud",
      "primaryField": "zenvis_id",
      "api": "/zenvis/api/v1/entity/nginx_error_log/list",
      "defaultParams": {
        "page": 1,
        "perPage": 10,
        "orderBy": "log_time",
        "orderDir": "desc"
      },
      "pageField": "page",
      "perPageField": "perPage",
      "perPage": 10,
      "perPageAvailable": [10, 20, 50, 100],
      "footerToolbar": ["statistics", "switch-per-page", "pagination"],
      "autoGenerateFilter": true,
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "暂无错误日志",
      "columns": [
        {
          "name": "log_time",
          "label": "日志时间",
          "type": "datetime",
          "sortable": true,
          "width": 170
        },
        {
          "name": "level",
          "label": "级别",
          "type": "mapping",
          "map": {
            "debug": "<span class='label label-default'>debug</span>",
            "info": "<span class='label label-info'>info</span>",
            "notice": "<span class='label label-info'>notice</span>",
            "warn": "<span class='label label-warning'>warn</span>",
            "error": "<span class='label label-danger'>error</span>",
            "crit": "<span class='label label-danger'>crit</span>",
            "alert": "<span class='label label-danger'>alert</span>",
            "emerg": "<span class='label label-danger'>emerg</span>",
            "*": "<span class='label label-default'>${level}</span>"
          },
          "sortable": true,
          "width": 100
        },
        {
          "name": "client_addr",
          "label": "客户端 IP",
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.nginx.ip-statistics?ip=${client_addr|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${client_addr | default:'-'}"
          },
          "copyable": true,
          "width": 140
        },
        {
          "name": "server_addr",
          "label": "服务端地址",
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.nginx.ip-statistics?ip=${server_addr|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${server_addr | default:'-'}"
          },
          "copyable": true,
          "toggled": false
        },
        {
          "name": "message",
          "label": "错误消息",
          "type": "tpl",
          "tpl": "${message | truncate:100}",
          "popOver": {
            "body": {
              "type": "tpl",
              "tpl": "${message}"
            }
          },
          "minWidth": 320
        },
        {
          "name": "pid",
          "label": "进程 PID",
          "toggled": false
        },
        {
          "name": "tid",
          "label": "线程 ID",
          "toggled": false
        },
        {
          "name": "connection_id",
          "label": "连接 ID",
          "toggled": false
        },
        {
          "type": "operation",
          "label": "操作",
          "fixed": "right",
          "width": 100,
          "buttons": [
            {
              "type": "button",
              "label": "详情",
              "level": "info",
              "actionType": "url",
              "url": "/#/service/low-code-page/com.coolxer.plugin.nginx.detail-error-log?record_id=${zenvis_id|url_encode}",
              "blank": true
            }
          ]
        }
      ]
    }
  ]
}
