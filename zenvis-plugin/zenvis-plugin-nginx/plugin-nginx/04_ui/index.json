{
  "type": "page",
  "title": "Nginx日志监控概览",
  "body": [
    {
      "type": "service",
      "api": {
        "method": "post",
        "url": "/zenvis/api/v1/entity/overview/query",
        "data": {
          "entities": [
            "nginx_access_log",
            "nginx_error_log"
          ],
          "time_range": {
            "preset": "TODAY"
          },
          "comparison": "NONE"
        },
        "adaptor": "var d=payload&&payload.data?payload.data:{},rows=d.result&&Array.isArray(d.result.rows)?d.result.rows:[],out={};rows.forEach(function(r){out[r.entity]=Number(r.all_time_count||0);out[r.entity+'_increase']=Number(r.current_value||0);});return {status:0,msg:'',data:out};"
      },
      "body": {
        "type": "grid",
        "gap": "md",
        "columns": [
          {
            "md": 6,
            "body": {
              "type": "panel",
              "title": "访问日志",
              "body": "<div style='font-size:28px;font-weight:700'>${nginx_access_log || 0}</div><div>今日新增 ${nginx_access_log_increase || 0}</div>"
            }
          },
          {
            "md": 6,
            "body": {
              "type": "panel",
              "title": "错误日志",
              "body": "<div style='font-size:28px;font-weight:700'>${nginx_error_log || 0}</div><div>今日新增 ${nginx_error_log_increase || 0}</div>"
            }
          }
        ]
      }
    },
    {
      "type": "chart",
      "height": 380,
      "api": {
        "method": "post",
        "url": "/zenvis/api/v1/entity/trend/query",
        "data": {
          "entities": [
            "nginx_access_log",
            "nginx_error_log"
          ],
          "time_range": {
            "preset": "LAST_7_DAYS"
          },
          "granularity": "DAY"
        },
        "adaptor": "var d=payload&&payload.data?payload.data:{},o=d.echarts&&d.echarts.option?d.echarts.option:{};return {status:0,msg:'',data:{chart_dataset:o.dataset||{source:[]},chart_series:o.series||[]}};"
      },
      "config": {
        "title": {
          "text": "近 7 天日志趋势"
        },
        "tooltip": {
          "trigger": "axis"
        },
        "legend": {},
        "dataset": "${chart_dataset}",
        "xAxis": {
          "type": "category"
        },
        "yAxis": {
          "type": "value",
          "minInterval": 1
        },
        "series": "${chart_series}"
      }
    },
    {
      "type": "grid",
      "gap": "md",
      "columns": [
        {
          "md": 6,
          "body": {
            "type": "chart",
            "height": 360,
            "api": {
              "method": "post",
              "url": "/zenvis/api/v1/entity/distribution/query",
              "data": {
                "mappings": [
                  {
                    "entity": "nginx_access_log",
                    "dimension": "status",
                    "label": "访问日志"
                  }
                ],
                "time_range": {
                  "preset": "ALL_TIME"
                },
                "limit": 10
              },
              "adaptor": "var d=payload&&payload.data?payload.data:{},o=d.echarts&&d.echarts.option?d.echarts.option:{};return {status:0,msg:'',data:{chart_dataset:o.dataset||{source:[]},chart_series:o.series||[]}};"
            },
            "config": {
              "title": {
                "text": "HTTP 状态码分布"
              },
              "tooltip": {
                "trigger": "axis"
              },
              "legend": {},
              "dataset": "${chart_dataset}",
              "xAxis": {
                "type": "value"
              },
              "yAxis": {
                "type": "category"
              },
              "series": "${chart_series}"
            }
          }
        },
        {
          "md": 6,
          "body": {
            "type": "chart",
            "height": 360,
            "api": {
              "method": "post",
              "url": "/zenvis/api/v1/entity/distribution/query",
              "data": {
                "mappings": [
                  {
                    "entity": "nginx_error_log",
                    "dimension": "level",
                    "label": "错误日志"
                  }
                ],
                "time_range": {
                  "preset": "ALL_TIME"
                },
                "limit": 10
              },
              "adaptor": "var d=payload&&payload.data?payload.data:{},o=d.echarts&&d.echarts.option?d.echarts.option:{};return {status:0,msg:'',data:{chart_dataset:o.dataset||{source:[]},chart_series:o.series||[]}};"
            },
            "config": {
              "title": {
                "text": "错误日志级别分布"
              },
              "tooltip": {
                "trigger": "axis"
              },
              "legend": {},
              "dataset": "${chart_dataset}",
              "xAxis": {
                "type": "value"
              },
              "yAxis": {
                "type": "category"
              },
              "series": "${chart_series}"
            }
          }
        }
      ]
    }
  ]
}
