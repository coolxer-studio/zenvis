{
  "type": "page",
  "title": "26 NFS协议审计",
  "body": [
    {
      "type": "crud",
      "api": "/zenvis/api/v1/entity/sangfor_sta_nfs/list",
      "autoGenerateFilter": true,
      "defaultParams": {
        "orderBy": "ts",
        "orderDir": "desc"
      },
      "columns": [
        {
          "name": "logid",
          "label": "日志ID",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sangfor.sta.detail-nfs?record_id=${zenvis_id|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${logid}"
          }
        },
        {
          "name": "ts",
          "label": "事件时间",
          "searchable": {
            "type": "input-datetime-range",
            "name": "ts"
          },
          "sortable": true
        },
        {
          "name": "uid",
          "label": "会话唯一ID",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "src_ip",
          "label": "源IP",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sangfor.sta.ip-statistics?ip=${src_ip|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${src_ip}"
          }
        },
        {
          "name": "src_port",
          "label": "源端口",
          "searchable": true
        },
        {
          "name": "dst_ip",
          "label": "目的IP",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sangfor.sta.ip-statistics?ip=${dst_ip|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${dst_ip}"
          }
        },
        {
          "name": "dst_port",
          "label": "目的端口",
          "searchable": true
        },
        {
          "name": "src_mac",
          "label": "源MAC",
          "searchable": true
        },
        {
          "name": "dst_mac",
          "label": "目的MAC",
          "searchable": true
        },
        {
          "name": "xid",
          "label": "程序编号",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "rpc_version",
          "label": "RPC协议版本",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "prog",
          "label": "远程程序号,指RPC上层协议",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "vers",
          "label": "RPC协议版本",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "proc",
          "label": "调用的过程",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "user_id",
          "label": "用户id",
          "searchable": true,
          "toggled": false,
          "copyable": true
        },
        {
          "name": "group_id",
          "label": "用户组id",
          "searchable": true,
          "toggled": false,
          "copyable": true
        },
        {
          "name": "call",
          "label": "请求内容",
          "searchable": false,
          "toggled": false,
          "type": "tpl",
          "tpl": "${call | json | truncate:60}",
          "popOver": {
            "body": {
              "type": "json",
              "value": "${call | json}"
            }
          }
        },
        {
          "name": "reply",
          "label": "响应内容",
          "searchable": false,
          "toggled": false,
          "type": "tpl",
          "tpl": "${reply | json | truncate:60}",
          "popOver": {
            "body": {
              "type": "json",
              "value": "${reply | json}"
            }
          }
        },
        {
          "name": "logtype",
          "label": "日志类型",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "devname",
          "label": "设备名称",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "ds",
          "label": "日期",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "hh",
          "label": "小时",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "vendor",
          "label": "厂商",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "iptype",
          "label": "IP类型",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "appproto",
          "label": "应用层协议",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "transproto",
          "label": "传输层协议",
          "searchable": true,
          "toggled": false
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "暂无NFS协议审计数据"
    }
  ]
}
