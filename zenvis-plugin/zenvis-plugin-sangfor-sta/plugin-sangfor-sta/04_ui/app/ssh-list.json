{
  "type": "page",
  "title": "45 SSH协议审计",
  "body": [
    {
      "type": "crud",
      "api": "/zenvis/api/v1/entity/sangfor_sta_ssh/list",
      "autoGenerateFilter": true,
      "defaultParams": {
        "orderBy": "ts",
        "orderDir": "desc"
      },
      "columns": [
        {
          "name": "logid",
          "label": "日志ID",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sangfor.sta.detail-ssh?record_id=${zenvis_id|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${logid}"
          }
        },
        {
          "name": "ts",
          "label": "事件时间",
          "searchable": {
            "type": "input-datetime-range",
            "name": "ts"
          },
          "sortable": true
        },
        {
          "name": "uid",
          "label": "会话唯一ID",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "src_ip",
          "label": "源IP",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sangfor.sta.ip-statistics?ip=${src_ip|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${src_ip}"
          }
        },
        {
          "name": "src_port",
          "label": "源端口",
          "searchable": true
        },
        {
          "name": "dst_ip",
          "label": "目的IP",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sangfor.sta.ip-statistics?ip=${dst_ip|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${dst_ip}"
          }
        },
        {
          "name": "dst_port",
          "label": "目的端口",
          "searchable": true
        },
        {
          "name": "src_mac",
          "label": "源MAC",
          "searchable": true
        },
        {
          "name": "dst_mac",
          "label": "目的MAC",
          "searchable": true
        },
        {
          "name": "protocol_version",
          "label": "协议版本",
          "searchable": true
        },
        {
          "name": "client_version",
          "label": "客户端版本",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "server_version",
          "label": "服务器版本",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "kex_alg",
          "label": "密钥交换算法",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "host_key_alg",
          "label": "主机密钥服务算法",
          "searchable": true,
          "toggled": false,
          "copyable": true
        },
        {
          "name": "encryption_alg",
          "label": "加密算法",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "mac_alg",
          "label": "MAC算法",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "compression_alg",
          "label": "压缩算法",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "host_key",
          "label": "主机密钥",
          "searchable": true,
          "toggled": false,
          "copyable": true
        },
        {
          "name": "ssh_message_code_list",
          "label": "数据包message_code列表",
          "searchable": false,
          "toggled": false,
          "type": "tpl",
          "tpl": "${ssh_message_code_list | join:'、' | truncate:60}"
        },
        {
          "name": "ssh_bytes_list",
          "label": "数据包tcp_length列表",
          "searchable": false,
          "toggled": false,
          "type": "tpl",
          "tpl": "${ssh_bytes_list | join:'、' | truncate:60}"
        },
        {
          "name": "ssh_direction_list",
          "label": "数据包上下行方向列表",
          "searchable": false,
          "toggled": false,
          "type": "tpl",
          "tpl": "${ssh_direction_list | join:'、' | truncate:60}"
        },
        {
          "name": "signature",
          "label": "密钥交换算法模量",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "p",
          "label": "签名数据",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "kex_firstpack",
          "label": "KEX 第一个包",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "logtype",
          "label": "日志类型",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "devname",
          "label": "设备名称",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "ds",
          "label": "日期",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "hh",
          "label": "小时",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "vendor",
          "label": "厂商",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "iptype",
          "label": "IP类型",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "appproto",
          "label": "应用层协议",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "transproto",
          "label": "传输层协议",
          "searchable": true,
          "toggled": false
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "暂无SSH协议审计数据"
    }
  ]
}
