{
  "type": "page",
  "title": "46 SSL协议审计",
  "body": [
    {
      "type": "crud",
      "api": "/zenvis/api/v1/entity/sangfor_sta_ssl/list",
      "autoGenerateFilter": true,
      "defaultParams": {
        "orderBy": "ts",
        "orderDir": "desc"
      },
      "columns": [
        {
          "name": "logid",
          "label": "日志ID",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sangfor.sta.detail-ssl?record_id=${zenvis_id|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${logid}"
          }
        },
        {
          "name": "ts",
          "label": "事件时间",
          "searchable": {
            "type": "input-datetime-range",
            "name": "ts"
          },
          "sortable": true
        },
        {
          "name": "uid",
          "label": "会话唯一ID",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "src_ip",
          "label": "源IP",
          "searchable": true,
          "copyable": true,
