            "type": "tpl",
            "tpl": "${dst_ip}"
          }
        },
        {
          "name": "dst_port",
          "label": "目的端口",
          "searchable": true
        },
        {
          "name": "logtype",
          "label": "日志类型",
          "searchable": true
        },
        {
