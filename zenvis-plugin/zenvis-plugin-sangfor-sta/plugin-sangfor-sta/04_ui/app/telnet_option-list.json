{
  "type": "page",
  "title": "51 TELNET选项审计",
  "body": [
    {
      "type": "crud",
      "api": "/zenvis/api/v1/entity/sangfor_sta_telnet_option/list",
      "autoGenerateFilter": true,
      "defaultParams": {
        "orderBy": "ts",
        "orderDir": "desc"
      },
      "columns": [
        {
          "name": "logid",
