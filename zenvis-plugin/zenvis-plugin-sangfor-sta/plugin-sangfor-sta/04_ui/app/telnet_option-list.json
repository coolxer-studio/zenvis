          "body": {
            "type": "tpl",
            "tpl": "${dst_ip}"
          }
        },
        {
          "name": "dst_port",
          "label": "目的端口",
          "searchable": true
        },
        {
          "name": "terminal_type",
          "label": "终端类型",
          "searchable": true
        },
        {
          "name": "echo_mode",
          "label": "服务器是否响应用户键入的每个字节",
          "searchable": true
        },
        {
          "name": "encrypt_mode",
          "label": "是否加密传输",
          "searchable": true
        },
        {
          "name": "binary_mode",
          "label": "是否将数据视为二进制传输",
          "searchable": true,
          "toggled": false
        },
        {
