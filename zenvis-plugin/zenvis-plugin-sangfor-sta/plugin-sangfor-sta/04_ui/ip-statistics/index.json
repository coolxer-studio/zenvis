              "type": "tpl",
              "html": "${chart_html | raw}"
            },
            {
              "type": "table",
              "title": "数据类型统计明细",
              "source": "${rows || []}",
              "columns": [
                {
                  "name": "label",
                  "label": "数据类型"
                },
                {
                  "name": "entity",
                  "label": "实体",
                  "copyable": true
                },
                {
                  "name": "fields",
                  "label": "参与匹配的 IP 字段",
                  "type": "tpl",
                  "tpl": "${fields|join:'、'|default:'无 IP 字段'}"
                },
                {
                  "name": "total",
                  "label": "命中数量",
                  "sortable": true
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
