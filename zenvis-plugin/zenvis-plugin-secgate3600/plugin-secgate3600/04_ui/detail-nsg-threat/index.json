{
  "type": "page",
  "title": "SecGate 3600 NSG 威胁事件详情",
  "subTitle": "按 Zenvis 内置记录 ID 展示一条 threat 事件的完整信息",
  "body": [
    {"type":"alert","level":"warning","showIcon":true,"visibleOn":"${!record_id}","body":"详情链接缺少 Zenvis 内置记录 ID，无法查询当前记录。"},
    {
      "type": "service",
      "api": {"method":"get","url":"/zenvis/api/v1/entity/secgate3600_nsg_threat_event/${record_id}/view","sendOn":"${!!record_id}"},
      "body": [
        {"type":"alert","level":"info","showIcon":true,"body":"${threat_name || '-'} · ${threat_severity || '-'} · ${action || '-'} · ${addr_src || '-'} → ${addr_dst || '-'}"},
        {
          "type": "property",
          "title": "威胁与处置",
          "column": 3,
          "items": [
            {"label":"平台记录 ID","content":"${zenvis_id | default:'-'}","span":2},
            {"label":"入库时间","content":"${zenvis_insert_time | default:'-'}"},
            {"label":"威胁 ID","content":"${threat_id | default:'-'}"},
            {"label":"事件时间","content":"${time | default:'-'}"},
            {"label":"威胁名称","content":"${threat_name | default:'-'}"},
            {"label":"威胁等级","content":"${threat_severity | default:'-'}"},
            {"label":"检测模块","content":"${module | default:'-'}"},
            {"label":"威胁类型","content":"${threat_type | default:'-'}"},
            {"label":"威胁分类","content":"${threat_class | default:'-'}"},
            {"label":"处置动作","content":"${action | default:'-'}"},
            {"label":"攻击方向","content":"${direction | default:'-'}"},
            {"label":"命中次数","content":"${hit_num | default:'-'}"},
            {"label":"历史命中次数","content":"${last_hit_num | default:'-'}"},
            {"label":"处置 ID","content":"${disposal_id | default:'-'}"},
            {"label":"IOC ID","content":"${ioc_id | default:'-'}"},
            {"label":"CVE ID","content":"${cve_id | default:'-'}"},
            {"label":"流行度","content":"${popularity | default:'-'}"}
          ]
        },
        {
          "type": "property",
          "title": "攻击链路与会话",
          "column": 3,
          "items": [
            {"label":"攻击者 IP","content":"${attacker_ip | default:'-'}"},
            {"label":"受害者 IP","content":"${victim_ip | default:'-'}"},
            {"label":"源 IP","content":"${addr_src | default:'-'}"},
            {"label":"源端口","content":"${port_src | default:'-'}"},
            {"label":"目的 IP","content":"${addr_dst | default:'-'}"},
            {"label":"目的端口","content":"${port_dst | default:'-'}"},
            {"label":"NAT 后源地址","content":"${nataddr_src | default:'-'}"},
            {"label":"NAT 后源端口","content":"${natport_src | default:'-'}"},
            {"label":"NAT 后目的地址","content":"${nataddr_dst | default:'-'}"},
            {"label":"NAT 后目的端口","content":"${natport_dst | default:'-'}"},
            {"label":"传输协议","content":"${proto | default:'-'}"},
            {"label":"会话 ID","content":"${session_id | default:'-'}"},
            {"label":"应用名称","content":"${appname | default:'-'}"},
            {"label":"应用风险","content":"${app_risk | default:'-'}"},
            {"label":"安全策略","content":"${rule | default:'-'}"}
          ]
        },
        {
          "type": "property",
          "title": "设备与地域",
          "column": 3,
          "items": [
            {"label":"设备编号","content":"${devid | default:'-'}"},
            {"label":"设备名称","content":"${dname | default:'-'}"},
            {"label":"设备序列号","content":"${serial | default:'-'}"},
            {"label":"虚拟系统","content":"${vsys | default:'-'}"},
            {"label":"源安全域","content":"${zone_src | default:'-'}"},
            {"label":"目的安全域","content":"${zone_dst | default:'-'}"},
            {"label":"源位置","content":"${locale_src | default:'-'}"},
            {"label":"目的位置","content":"${locale_dst | default:'-'}"},
            {"label":"应用类别","content":"${app_category | default:'-'}"}
          ]
        },
        {"type":"panel","title":"威胁详情","body":{"type":"tpl","tpl":"<pre style='margin:0;max-height:280px;overflow:auto;white-space:pre-wrap;word-break:break-all;padding:16px;border-radius:8px;background:#f2f4f7;color:#101828'>${detail_zh || detail || '-'}</pre>"}},
        {
          "type": "property",
          "title": "关联对象与 Syslog 外层信息",
          "column": 3,
          "items": [
            {"label":"相关 URL","content":"${url | default:'-'}","span":2},
            {"label":"相关域名","content":"${dns_domain | default:'-'}"},
            {"label":"相关文件名","content":"${filename | default:'-'}"},
            {"label":"文件路径","content":"${filepath | default:'-'}","span":2},
            {"label":"样本名称","content":"${sample_name | default:'-'}"},
            {"label":"样本类型","content":"${sample_type | default:'-'}"},
            {"label":"样本 MD5","content":"${sample_md5 | default:'-'}"},
            {"label":"Syslog 来源 IP","content":"${syslog_source_ip | default:'-'}"},
            {"label":"Syslog Host","content":"${syslog_host | default:'-'}"},
            {"label":"Syslog 主机名","content":"${syslog_hostname | default:'-'}"},
            {"label":"Syslog 接收时间","content":"${syslog_timestamp | default:'-'}"},
            {"label":"Syslog 级别","content":"${syslog_severity | default:'-'}"}
          ]
        },
        {"type":"panel","title":"Syslog 原始消息","body":{"type":"tpl","tpl":"<pre style='margin:0;max-height:420px;overflow:auto;white-space:pre-wrap;word-break:break-all;padding:16px;border-radius:8px;background:#101828;color:#e4e7ec'>${syslog_message || '-'}</pre>"}}
      ]
    }
  ]
}
