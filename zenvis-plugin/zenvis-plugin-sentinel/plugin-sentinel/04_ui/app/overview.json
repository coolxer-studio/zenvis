            },
            "config": {
              "title": {
                "text": "近 7 天会话事件趋势（按小时）"
              },
              "tooltip": {
                "trigger": "axis"
              },
              "legend": {},
              "dataset": "${chart_dataset}",
              "xAxis": {
                "type": "category"
              },
              "yAxis": {
                "type": "value",
                "minInterval": 1
              },
              "series": "${chart_series}"
            }
          }
        },
        {
          "md": 5,
          "body": {
            "type": "chart",
            "height": 380,
            "api": {
              "method": "post",
              "url": "/zenvis/api/v1/entity/distribution/query",
              "data": {
                "mappings": [
                  {
                    "entity": "sentinel_chat_session_event",
                    "dimension": "event_kind",
                    "label": "会话事件类型",
                    "time_field": "occurred_at"
                  }
                ],
                "time_range": {
                  "preset": "ALL_TIME"
                },
                "limit": 10
              },
              "adaptor": "var d=payload&&payload.data?payload.data:{},o=d.echarts&&d.echarts.option?d.echarts.option:{};return {status:0,msg:'',data:{chart_dataset:o.dataset||{source:[]},chart_series:o.series||[]}};"
            },
            "config": {
              "title": {
                "text": "会话事件类型分布"
              },
              "tooltip": {
                "trigger": "axis"
              },
              "legend": {},
              "dataset": "${chart_dataset}",
              "xAxis": {
                "type": "value"
              },
              "yAxis": {
                "type": "category"
              },
              "series": "${chart_series}"
            }
          }
        }
      ]
    },
    {
      "type": "grid",
      "gap": "md",
      "columns": [
        {
          "md": 6,
          "body": {
            "type": "chart",
            "height": 360,
            "api": {
