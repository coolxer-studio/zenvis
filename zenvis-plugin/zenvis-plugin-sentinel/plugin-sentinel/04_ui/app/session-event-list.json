{
  "type": "page",
  "title": "智能体会话事件",
  "remark": "Warden 会话流（chat.session.*.v1，schema_version 1.0）。点击事件幂等键进入详情；点击会话号可重建该会话消息线。",
  "body": [
    {
      "type": "crud",
      "api": "/zenvis/api/v1/entity/sentinel_chat_session_event/list",
      "autoGenerateFilter": true,
      "defaultParams": {
        "orderBy": "occurred_at",
        "orderDir": "desc"
      },
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "暂无会话流事件",
      "columns": [
        {
          "name": "event_key",
          "label": "事件幂等键",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sentinel.detail-chat-session-event?record_id=${zenvis_id|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${event_key}"
          }
        },
        {
          "name": "occurred_at",
          "label": "事件时刻",
          "sortable": true,
          "searchable": {
            "type": "input-datetime-range",
            "name": "occurred_at"
          }
        },
        {
          "name": "event_kind",
          "label": "会话事件类型",
          "searchable": {
            "type": "select",
            "name": "event_kind",
            "options": [
              { "label": "会话首见 started", "value": "started" },
              { "label": "增量追加 append", "value": "append" },
              { "label": "全量快照 snapshot", "value": "snapshot" },
              { "label": "历史改写 mutation", "value": "mutation" }
            ]
          }
        },
        {
          "name": "session_id",
          "label": "网关会话号",
          "searchable": true,
          "copyable": true,
          "type": "link",
          "href": "/#/service/low-code-page/com.coolxer.plugin.sentinel.session-timeline?session_id=${session_id|url_encode}",
          "blank": true,
          "body": {
            "type": "tpl",
            "tpl": "${session_id}"
          }
        },
        {
          "name": "session_id_source",
          "label": "会话号来源",
          "searchable": {
            "type": "select",
            "name": "session_id_source",
            "options": [
              { "label": "请求头 header", "value": "header" },
              { "label": "消息体字段 body_field", "value": "body_field" },
              { "label": "种子哈希派生 derived_hash", "value": "derived_hash" }
            ]
          }
        },
        {
          "name": "message_count",
          "label": "消息数量",
          "sortable": true
        },
        {
          "name": "message_roles",
          "label": "消息角色",
          "toggled": false
        },
        {
          "name": "message_ids",
          "label": "消息ID集合",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "msg_hashes",
          "label": "消息哈希集合",
          "searchable": true,
          "toggled": false
        },
        {
          "name": "turn_no",
          "label": "轮次",
          "sortable": true,
          "toggled": false
        },
        {
          "name": "msg_index",
          "label": "改写消息下标",
          "sortable": true,
          "toggled": false
        },
        {
          "name": "old_message_id",
          "label": "被替换消息ID",
          "searchable": true,
          "copyable": true,
          "toggled": false
        },
        {
          "name": "old_msg_hash",
          "label": "被替换消息哈希",
          "searchable": true,
          "copyable": true,
          "toggled": false
        },
        {
          "name": "new_message_id",
          "label": "新消息ID",
          "searchable": true,
          "copyable": true,
          "toggled": false
        },
        {
          "name": "new_msg_hash",
          "label": "新消息哈希",
          "searchable": true,
          "copyable": true,
          "toggled": false
        },
        {
          "name": "request_method",
          "label": "请求方法",
          "searchable": {
            "type": "select",
            "name": "request_method",
            "options": [
              { "label": "POST", "value": "POST" },
              { "label": "GET", "value": "GET" },
              { "label": "PUT", "value": "PUT" },
              { "label": "PATCH", "value": "PATCH" },
              { "label": "DELETE", "value": "DELETE" }
            ]
          }
        },
        {
          "name": "request_path",
          "label": "原始请求路径",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "request_wire",
          "label": "协议线格式",
          "searchable": {
            "type": "select",
            "name": "request_wire",
            "options": [
              { "label": "OpenAI", "value": "openai" },
              { "label": "Anthropic", "value": "anthropic" }
            ]
          }
        },
        {
          "name": "request_remote_addr",
          "label": "客户端地址",
          "searchable": true,
          "copyable": true
        },
        {
          "name": "messages",
          "label": "事件消息",
          "toggled": false,
          "type": "tpl",
          "tpl": "<span class=\"text-truncate d-inline-block\" style=\"max-width: 220px\">${messages}</span>",
          "popOver": {
            "trigger": "hover",
            "body": {
              "type": "json",
              "value": "${messages|raw}",
              "levelExpand": 2,
              "mutable": false,
              "displayDataTypes": false,
              "enableClipboard": true
            }
          }
        },
        {
          "name": "mutation",
          "label": "历史改写详情",
          "toggled": false,
          "type": "tpl",
          "tpl": "<span class=\"text-truncate d-inline-block\" style=\"max-width: 220px\">${mutation}</span>",
          "popOver": {
            "trigger": "hover",
            "body": {
              "type": "json",
              "value": "${mutation|raw}",
              "levelExpand": 2,
              "mutable": false,
              "displayDataTypes": false,
              "enableClipboard": true
            }
          }
        },
        {
          "name": "request_headers",
          "label": "请求头快照",
          "toggled": false,
          "type": "tpl",
          "tpl": "<span class=\"text-truncate d-inline-block\" style=\"max-width: 220px\">${request_headers}</span>",
          "popOver": {
            "trigger": "hover",
            "body": {
              "type": "json",
              "value": "${request_headers|raw}",
              "levelExpand": 2,
              "mutable": false,
              "displayDataTypes": false,
              "enableClipboard": true
            }
          }
        },
        {
          "name": "message_type",
          "label": "消息类型",
          "searchable": {
            "type": "select",
            "name": "message_type",
            "options": [
              { "label": "started", "value": "chat.session.started.v1" },
              { "label": "append", "value": "chat.session.append.v1" },
              { "label": "snapshot", "value": "chat.session.snapshot.v1" },
              { "label": "mutation", "value": "chat.session.mutation.v1" }
            ]
          },
          "toggled": false
        },
        {
          "name": "source_component",
          "label": "来源组件",
          "toggled": false
        },
        {
          "name": "schema_version",
          "label": "信封格式版本",
          "toggled": false
        }
      ]
    }
  ]
}
