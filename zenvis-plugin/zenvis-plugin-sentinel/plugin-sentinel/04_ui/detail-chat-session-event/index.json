{
  "type": "page",
  "title": "智能体会话事件详情",
  "subTitle": "使用 Zenvis 平台记录 ID 精确查询",
  "toolbar": [
    {
      "type": "button",
      "label": "查看会话消息线",
      "level": "primary",
      "visibleOn": "${!!session_id}",
      "actionType": "url",
      "url": "/#/service/low-code-page/com.coolxer.plugin.sentinel.session-timeline?session_id=${session_id|url_encode}",
      "blank": true
    },
    {
      "type": "button",
      "label": "关闭",
      "actionType": "custom",
      "onEvent": {
        "click": {
          "actions": [
            {
              "actionType": "custom",
              "script": "window.close();"
            }
          ]
        }
      }
    }
  ],
  "body": [
    {
      "type": "alert",
      "level": "warning",
      "showIcon": true,
      "visibleOn": "${!record_id}",
      "body": "详情链接缺少 record_id，无法查询当前记录。"
    },
    {
      "type": "service",
      "api": {
        "method": "get",
        "url": "/zenvis/api/v1/entity/sentinel_chat_session_event/${record_id}/view",
        "sendOn": "${!!record_id}"
      },
      "messages": {
        "fetchFailed": "记录不存在或没有访问权限"
      },
      "body": [
        {
          "type": "alert",
          "level": "info",
          "showIcon": true,
          "body": "会话流保留消息原文，可能包含敏感内容。页面仅做只读展示；请按数据治理要求控制访问范围。会话事件按 at-least-once 投递，同一 event_key 可能重复入库，消息线重建时会自动去重。"
        },
        {
          "type": "property",
          "title": "事件身份",
          "column": 3,
          "items": [
            {
              "label": "平台记录 ID",
              "content": "${zenvis_id | default:'-'}",
              "remark": "Zenvis 自动生成的记录 UUID。"
            },
            {
              "label": "平台入库时间",
              "content": "${zenvis_insert_time | default:'-'}",
              "remark": "Zenvis 实际接收时间。"
            },
            {
              "label": "事件幂等键",
              "content": "${event_key | default:'-'}",
              "remark": "append/snapshot/mutation 取上游事件 ID；started 为 st_<session_id>。"
            },
            {
              "label": "事件时刻",
              "content": "${occurred_at | default:'-'}",
              "remark": "上游 epoch 秒转换为 Asia/Shanghai。"
            },
            {
              "label": "会话事件类型",
              "content": "${event_kind | default:'-'}",
              "remark": "started / append / snapshot / mutation。"
            },
            {
              "label": "消息类型",
              "content": "${message_type | default:'-'}",
              "remark": "chat.session.*.v1 原值。"
            },
            {
              "label": "消息数量",
              "content": "${message_count | default:'-'}",
              "remark": "append/snapshot 为消息数组长度；mutation 为 1；started 为 0。"
            },
            {
              "label": "轮次",
              "content": "${turn_no | default:'-'}",
              "remark": "仅 snapshot 事件携带。"
            },
            {
              "label": "改写消息下标",
              "content": "${msg_index | default:'-'}",
              "remark": "仅 mutation 事件携带；system 伪消息为 -1。"
            },
            {
              "label": "信封格式版本",
              "content": "${schema_version | default:'-'}",
              "remark": "会话流当前为 1.0。"
            },
            {
              "label": "来源组件",
              "content": "${source_component | default:'-'}",
              "remark": "会话流由 Warden 数据面导出，当前为 gateway。"
            }
          ]
        },
        {
          "type": "property",
          "title": "会话与请求",
          "column": 3,
          "items": [
            {
              "label": "网关会话号",
              "content": "${session_id | default:'-'}",
              "remark": "可点击工具栏按钮重建整条消息线。"
            },
            {
              "label": "会话号来源",
              "content": "${session_id_source | default:'-'}",
              "remark": "header / body_field / derived_hash。"
            },
            {
              "label": "请求方法",
              "content": "${request_method | default:'-'}",
              "remark": "网关签收现场的 HTTP 方法。"
            },
            {
              "label": "原始请求路径",
              "content": "${request_path | default:'-'}",
              "remark": "客户端原始请求路径。"
            },
            {
              "label": "协议线格式",
              "content": "${request_wire | default:'-'}",
              "remark": "openai / anthropic。"
            },
            {
              "label": "客户端地址",
              "content": "${request_remote_addr | default:'-'}",
              "remark": "网关观察到的 IPv4/IPv6 地址。"
            },
            {
              "label": "消息ID集合",
              "content": "${message_ids | default:'-'}",
              "remark": "从本事件消息中抽取。"
            },
            {
              "label": "消息哈希集合",
              "content": "${msg_hashes | default:'-'}",
              "remark": "可与安全事件 msg_hash 精确关联。"
            },
            {
              "label": "消息角色集合",
              "content": "${message_roles | default:'-'}",
              "remark": "system / user / assistant / tool 等。"
            }
          ]
        },
        {
          "type": "property",
          "title": "历史改写标识",
          "column": 4,
          "visibleOn": "${event_kind === 'mutation'}",
          "items": [
            {
              "label": "被替换消息ID",
              "content": "${old_message_id | default:'-'}",
              "remark": "payload.old.message_id，永不复用。"
            },
            {
              "label": "被替换消息哈希",
              "content": "${old_msg_hash | default:'-'}",
              "remark": "重建消息线时据此删除旧消息。"
            },
            {
              "label": "新消息ID",
              "content": "${new_message_id | default:'-'}",
              "remark": "payload.new.message_id。"
            },
            {
              "label": "新消息哈希",
              "content": "${new_msg_hash | default:'-'}",
              "remark": "payload.new.msg_hash。"
            }
          ]
        },
        {
          "type": "panel",
          "title": "事件消息（StreamMessage，含 original 原文）",
          "body": {
            "type": "json",
            "value": "${messages|raw}",
            "levelExpand": 3,
            "mutable": false,
            "displayDataTypes": false,
            "enableClipboard": true
          }
        },
        {
          "type": "panel",
          "title": "历史改写详情（old / new）",
          "visibleOn": "${event_kind === 'mutation'}",
          "body": {
            "type": "json",
            "value": "${mutation|raw}",
            "levelExpand": 3,
            "mutable": false,
            "displayDataTypes": false,
            "enableClipboard": true
          }
        },
        {
          "type": "panel",
          "title": "请求头快照（已剔除 x-bf-*）",
          "body": {
            "type": "json",
            "value": "${request_headers|raw}",
            "levelExpand": 2,
            "mutable": false,
            "displayDataTypes": false,
            "enableClipboard": true
          }
        }
      ]
    }
  ]
}
