# 复制为 .env 后按需修改。切勿提交真实 .env。

ARCH=amd64
TZ=Asia/Shanghai
ZENVIS_IMAGE_REGISTRY=crpi-4pdi7kz96g4v0tg3.cn-beijing.personal.cr.aliyuncs.com/coolxer-studio
EXPORTERS_VERSION=1.0.0

# 默认与 ZenVis 主栈网络（compose project = zenvis）保持一致
ZENVIS_NETWORK_NAME=zenvis_zenvis-network

EXPORTERS_BIND_ADDRESS=127.0.0.1

# 与被监控的 ZenVis 基础设施保持一致
MYSQL_HOST=mysql-service
MYSQL_PORT=3306
MYSQL_EXPORTER_USER=root
MYSQL_ROOT_PASSWORD=
# 如需专用采集账号则填写以下两项（留空则使用 root）
MYSQL_EXPORTER_PASSWORD=

REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=kafka-service:9092
