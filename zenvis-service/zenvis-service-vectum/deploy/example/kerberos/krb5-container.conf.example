# ============================================================
# 容器内使用的 krb5.conf 示例
# ============================================================
# 宿主机 KDC 端口映射为 8888 时，容器通过 host.docker.internal 访问：
#   docker compose -f deploy/docker-compose.yml up -d
# 将本文件挂载到容器 /etc/krb5.conf，并确保 KDC 端口已发布到宿主机。
# ============================================================

[libdefaults]
    default_realm = EXAMPLE.COM
    dns_lookup_realm = false
    dns_lookup_kdc = false
    rdns = false
    udp_preference_limit = 1
    ticket_lifetime = 24h
    renew_lifetime = 7d
    forwardable = true
    default_ccache_name = FILE:/tmp/krb5cc_vectum

[realms]
    EXAMPLE.COM = {
        kdc = host.docker.internal:8888
        admin_server = host.docker.internal:8888
    }

[domain_realm]
    host.docker.internal = EXAMPLE.COM
